<?xml version="1.0" encoding="utf-8"?>
<!--
  Orpheus for Android — the Termux-free app.

  Notes on what is and is not requested here:

  * NO permissions are declared. The GUI binds 127.0.0.1 only, all storage is the app's
    private filesDir, and nothing needs the network permission to reach loopback. Add
    <uses-permission android:name="android.permission.INTERNET"/> ONLY if you want the
    news wire to fetch feeds or the node to gossip with remote peers — and if you do,
    read docs/security.md first and set a PSK.
  * extractNativeLibs="true" is REQUIRED: it makes the installer unpack lib/arm64-v8a/
    into nativeLibraryDir as real files with the execute bit, which is how the binary
    becomes runnable without ever living in a writable-executable directory.
  * usesCleartextTraffic is scoped by network_security_config.xml to localhost only.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="org.orpheus.latte">

    <application
        android:label="Orpheus"
        android:extractNativeLibs="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:allowBackup="false"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="Orpheus"
            android:configChanges="orientation|screenSize|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
