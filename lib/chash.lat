:: ===========================================================================
:: chash.lat — consistent hashing with virtual nodes (DDIA, Ch. 6, p. 204).
::
:: Keys and nodes hash onto one ring of size R; a key is owned by the first node
:: clockwise from it. Adding or removing a node moves only the keys between it
:: and its predecessor — about 1/N of them — instead of remapping everything (as
:: plain `hash(key) mod N` would). VIRTUAL NODES (several ring points per
:: physical node) smooth the load.   Arms prefixed `ch_`.
::
:: ring = list of [pos node] sorted ascending by pos.
:: ===========================================================================
import std
import dhash
core chash
  :: insert a [pos node] point keeping the ring sorted by pos
  ch_insert = fn [ring pt] ->
    loop with [c = ring, acc = 0] :
      if (c == 0) then (append (reverse acc) [ pt 0 ])
      else if ((lt (head pt) (head (head c))) == 0) then (append (reverse acc) [ pt c ])
      else again((tail c), [ (head c) acc ])
    end

  :: place `vn` virtual points for `node` on a ring of size R
  ch_addnode = fn [ring node vn ringsz] ->
    (foldl (fn [r i] -> (ch_insert r [ (dh_idx (dh_h1 (cat node (numtext i))) ringsz) node ]))
           ring (range vn))

  :: build a ring from a list of nodes
  ch_build = fn [nodes vn ringsz] ->
    (foldl (fn [r node] -> (ch_addnode r node vn ringsz)) 0 nodes)

  :: remove every ring point belonging to `node`
  ch_removenode = fn [ring node] -> (filter (fn [pt] -> (not ((tail pt) == node))) ring)

  :: which node owns `key`: first ring point with pos >= hash(key), else wrap
  ch_lookup = fn [ring key ringsz] ->
    let p = (dh_idx (dh_h1 key) ringsz) in
    loop with [c = ring] :
      if (c == 0) then (tail (head ring))
      else if ((gte (head (head c)) p) == 0) then (tail (head c))
      else again((tail c))
    end

  :: assign a list of keys: returns list of [key node]
  ch_assign = fn [ring keys ringsz] ->
    (map (fn [k] -> [ k (ch_lookup ring k ringsz) ]) keys)

  :: how many keys change owner between two assignments (the rebalance cost)
  ch_moved = fn [asgnA asgnB] ->
    loop with [xs = asgnA, ys = asgnB, n = 0] :
      if (xs == 0) then n
      else if ((tail (head xs)) == (tail (head ys))) then again((tail xs), (tail ys), n)
      else again((tail xs), (tail ys), +(n))
    end

  :: REPLICA PREFERENCE LIST (Dynamo): the next `n` DISTINCT physical nodes
  :: clockwise from a key — where its replicas live. Walking distinct nodes (not
  :: ring points) is what stops two replicas landing on the same machine's vnodes.
  ch_replicas = fn [ring key n ringsz] ->
    let start = (dh_idx (dh_h1 key) ringsz) in
    let rot = (append (filter (fn [pt] -> (gte (head pt) start)) ring)
                      (filter (fn [pt] -> (lt (head pt) start)) ring)) in
    loop with [c = rot, acc = 0, cnt = 0] :
      if (cnt == n) then (reverse acc)
      else if (c == 0) then (reverse acc)
      else if ((member (tail (head c)) acc) == 0) then again((tail c), acc, cnt)
      else again((tail c), [ (tail (head c)) acc ], +(cnt))
    end

  :: ---- RENDEZVOUS (Highest-Random-Weight) hashing: no ring at all -----------
  :: Each (node, key) pair gets a score; the key goes to the highest-scoring node.
  :: It gives the same minimal-movement property as a ring with simpler state and
  :: even load, and the top-k scores give the replica set directly.
  rv_score  = fn [node key] -> (dh_h1 (cat (cat node %124) key))   :: 124 = '|'
  rv_lookup = fn [nodes key] ->
    loop with [c = (tail nodes), best = (head nodes), bs = (rv_score (head nodes) key)] :
      if (c == 0) then best
      else let s = (rv_score (head c) key) in
        if (gt s bs) then again((tail c), (head c), s)
        else again((tail c), best, bs)
    end
  :: insert a node into a list kept sorted by descending score (for top-k)
  rv_ins = fn [ranked node key] ->
    loop with [c = ranked, acc = 0] :
      if (c == 0) then (append (reverse acc) [ node 0 ])
      else if ((gt (rv_score node key) (rv_score (head c) key)) == 0) then
        (append (reverse acc) [ node c ])
      else again((tail c), [ (head c) acc ])
    end
  :: the top `n` nodes for a key — the rendezvous-hashing replica set
  rv_topn = fn [nodes key n] ->
    (take n (foldl (fn [r nd] -> (rv_ins r nd key)) 0 nodes))
end
