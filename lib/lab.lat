:: lab.lat — a combined DATA + VISUALIZATION + ML text-frame workbench over the database.
:: One [%html ...] interface that (1) manipulates stored data (column statistics, class
:: counts, ordering), (2) visualizes it (per-class separation bars), and (3) trains and
:: evaluates a logistic model — all by pulling a standardized design matrix straight out of
:: the database through the db<->tensor bridge (db_ztrain / db_colstats / db_pluck).
import std
import num
import db
import fin
import stats
import plot
core lab

  :: ====================================================================================
  :: THE COMBINED DB -> ML PIPELINE  (stored records in, trained+evaluated model out)
  :: ====================================================================================
  :: Standardize on the training rows only (no test leakage), train the logistic core from
  :: lib/fin.lat, and score. Returns [ w b train_acc test_acc baseline ].
  lab_fit = fn [recs featfields labelfield split iters] ->
    let xs = (db_ztrain featfields recs split) in
    let ys = (db_pluck labelfield recs) in
    let xtr = (take split xs), ytr = (take split ys) in
    let xte = (drop split xs), yte = (drop split ys) in
    let wb = (lr_train xtr ytr [0 1500] iters) in
    let w = (head wb), b = (tail wb) in
    [ w [ b [ (lr_acc w b xtr ytr) [ (lr_acc w b xte yte) [ (base_acc yte) 0 ] ] ] ] ]
  lab_w     = fn [r] -> (nth r 0)
  lab_b     = fn [r] -> (nth r 1)
  lab_tracc = fn [r] -> (nth r 2)
  lab_teacc = fn [r] -> (nth r 3)
  lab_base  = fn [r] -> (nth r 4)

  :: ====================================================================================
  :: A SAMPLE LABELED DATASET (stored in the database) so the workbench runs standalone.
  :: ====================================================================================
  :: 16 rows [label f0 f1 f2]; f0 and f1 mostly separate the classes (two deliberately
  :: mislabelled rows keep it from being trivially separable), f2 is mostly noise. Classes
  :: are interleaved so a walk-forward split sees both. Field 5 is the row index, so the
  :: database can return the rows in insertion order despite cord-keyed storage.
  lab_data = fn [_] ->
    [ [0 2 3 5 0] [ [1 8 7 4 0] [ [0 3 2 6 0] [ [1 7 8 5 0] [ [0 1 4 3 0] [ [1 9 6 7 0]
    [ [0 4 1 5 0] [ [1 6 9 4 0] [ [0 2 2 6 0] [ [1 8 8 3 0] [ [1 3 7 5 0] [ [0 7 2 4 0]
    [ [0 1 1 2 0] [ [1 9 9 6 0] [ [0 9 8 4 0] [ [1 7 7 4 0] 0 ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ]
  lab_rec = fn [row i] ->
    [ [1 (nth row 0)] [ [2 (nth row 1)] [ [3 (nth row 2)] [ [4 (nth row 3)] [ [5 i] 0 ] ] ] ] ]
  lab_load = fn [_] ->
    loop with [i = 0, rs = (lab_data 0), d = (db_open 1 0 64)] :
      if (rs == 0) then d
      else again(+(i), (tail rs), (db_put d (cat %s (numtext i)) (lab_rec (head rs) i)))
    end
  lab_recs  = fn [d] -> (db_order 5 (db_scan d %s %t))   :: insertion (row-index) order
  lab_feats = fn [_] -> [ 2 [ 3 [ 4 0 ] ] ]              :: feature fields f0 f1 f2
  lab_label = fn [_] -> 1                                 :: the label field

  :: split a labelled record list by class (filter keeps where the predicate returns 0)
  lab_byclass = fn [recs c] -> (filter (fn [e] -> if ((db_fieldof e 1) == c) then 0 else 1) recs)
  lab_ones    = fn [recs] -> (foldl (fn [a y] -> if (y == 0) then a else +(a)) 0 (db_pluck 1 recs))

  :: ====================================================================================
  :: RENDERING HELPERS
  :: ====================================================================================
  :: a signed fixed-point fraction [s mag] (mag = value x1000) as a one-decimal number
  lab_num = fn [v] ->
    let s = (head v), mag = (tail v) in
    (catall [ (if (s == 1) then "-" else "") (numtext (div mag 1000)) "."
              (numtext (mod (div mag 100) 10)) 0 ])
  :: a fraction [s mag] (mag = fraction x1000 = tenths of a percent) as "83.3%"
  lab_pct = fn [f] -> let p = (tail f) in (catall [ (numtext (div p 10)) "." (numtext (mod p 10)) "%" 0 ])
  :: an HTML bar of pixel width w and a colour
  lab_bar = fn [w col] ->
    (catall [ "<span style=\"display:inline-block;height:10px;border-radius:2px;background:"
              col ";width:" (numtext w) "px\"></span>" 0 ])

  :: DATA: one column-statistics row [feature, mean, std] from db_colstats
  lab_colrow = fn [recs f] ->
    let st = (head (db_colstats [ f 0 ] recs)) in
    (catall [ "<tr><td>f" (numtext (sub f 2)) "</td><td align=right>" (lab_num (head st))
              "</td><td align=right>" (lab_num (tail st)) "</td></tr>" 0 ])

  :: VISUALIZATION: the per-class mean of feature f as two bars (shows the separation)
  lab_septwo = fn [recs f] ->
    let m0 = (db_nmean f (lab_byclass recs 0)), m1 = (db_nmean f (lab_byclass recs 1)) in
    (catall [ "<div style=\"margin:.1em 0\"><span style=\"display:inline-block;width:64px\">class 0</span>"
              (lab_bar (div (tail m0) 100) "#b0aa99") " " (lab_num m0) "</div>"
              "<div style=\"margin:.1em 0\"><span style=\"display:inline-block;width:64px\">class 1</span>"
              (lab_bar (div (tail m1) 100) "#5059c8") " " (lab_num m1) "</div>" 0 ])

  :: MODEL: an accuracy row (label, proportional bar, percentage)
  lab_accrow = fn [name acc col] ->
    (catall [ "<div style=\"margin:.1em 0\"><span style=\"display:inline-block;width:64px\">" name
              "</span>" (lab_bar (div (tail acc) 10) col) " " (lab_pct acc) "</div>" 0 ])
  :: MODEL: the learned weights, one labelled value per feature
  lab_weights = fn [ws] ->
    loop with [i = 0, w = ws, acc = ""] :
      if (w == 0) then acc
      else again(+(i), (tail w),
                 (cat acc (catall [ "<span style=\"display:inline-block;width:72px\">f"
                                    (numtext i) ": " (lab_num (head w)) "</span>" 0 ])))
    end

  :: ====================================================================================
  :: THE COMBINED TEXT FRAME
  :: ====================================================================================
  lab_frame = fn [recs] ->
    let n = (db_count recs), ones = (lab_ones recs), nf = (len (lab_feats 0)) in
    let split = (div (mul n 7) 10) in
    let r = (lab_fit recs (lab_feats 0) (lab_label 0) split 600) in
    [ %html (catall [
        "<div style=\"font:13px/1.5 system-ui,sans-serif\">"
        "<h3 style=\"margin:.1em 0\">Data lab &middot; manipulate, visualize, train</h3>"
        "<p style=\"color:#8a8676;margin:.2em 0\">one frame over lib/db.lat &middot; column statistics, class separation, and a logistic model trained through the db&rarr;tensor bridge</p>"
        "<h4 style=\"margin:.4em 0 .1em\">Data</h4>"
        "<p style=\"margin:.1em 0\">" (numtext n) " records &middot; " (numtext nf) " features &middot; "
          (numtext ones) " positive / " (numtext (sub n ones)) " negative</p>"
        "<table class=\"m\"><tr><th align=left>feature</th><th>mean</th><th>std</th></tr>"
        (catall (map (fn [f] -> (lab_colrow recs f)) (lab_feats 0))) "</table>"
        "<h4 style=\"margin:.4em 0 .1em\">Visualization &mdash; class separation on f0</h4>"
        (lab_septwo recs 2)
        "<h4 style=\"margin:.4em 0 .1em\">Model &mdash; trained on the db&rarr;tensor bridge</h4>"
        (lab_accrow "train" (lab_tracc r) "#5059c8")
        (lab_accrow "test" (lab_teacc r) "#2a9d8f")
        (lab_accrow "baseline" (lab_base r) "#b0aa99")
        "<p style=\"margin:.3em 0\"><b>weights</b> &middot; " (lab_weights (lab_w r)) "</p>"
        "<p style=\"color:#8a8676\">teaching/demo &middot; trained on " (numtext split) " of " (numtext n) " rows, evaluated on the rest</p>"
        "</div>" 0 ]) ]
  lab_dash = fn [_] -> (lab_frame (lab_recs (lab_load 0)))
end
