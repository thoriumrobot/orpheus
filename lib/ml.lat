:: ml.lat — training machine-learning models in Latte by gradient descent. Built on the
:: tensor + signed-number libraries (so it has real signed fixed-point arithmetic). The
:: worked model is linear regression  y = w·x + b  fit by batch gradient descent.
import tensor
core ml
  predict = fn [w b x] -> (nadd (nmul w x) b)

  :: one batch gradient-descent step; returns the updated [w b]
  gradstep = fn [w b xs ys lr] ->
    let cnt = (npos (mul (len xs) 1000)) in            :: number of points as a signed value
    let sums =
      loop with [px = xs, py = ys, sew = [0 0], se = [0 0]] :
        if (px == 0) then [ sew se ]
        else
          let e = (nsub (nadd (nmul w (head px)) b) (head py)) in   :: error = (w·x+b) - y
          again((tail px), (tail py), (nadd sew (nmul e (head px))), (nadd se e))
      end in
    let gw = (ndiv (head sums) cnt) in                 :: mean gradient wrt w
    let gb = (ndiv (tail sums) cnt) in                 :: mean gradient wrt b
    [ (nsub w (nmul lr gw)) (nsub b (nmul lr gb)) ]

  train = fn [w b xs ys lr iters] ->
    loop with [cw = w, cb = b, k = 0] :
      if (k == iters) then [ cw cb ]
      else
        let nx = (gradstep cw cb xs ys lr) in
        again((head nx), (tail nx), +(k))
    end


  :: mean squared error of the current model over the data (a signed number)
  mse = fn [w b xs ys] ->
    let cnt = (npos (mul (len xs) 1000)) in
    let s = loop with [px = xs, py = ys, acc = [0 0]] :
              if (px == 0) then acc
              else
                let e = (nsub (nadd (nmul w (head px)) b) (head py)) in
                again((tail px), (tail py), (nadd acc (nmul e e)))
            end in
    (ndiv s cnt)

  :: predictions for every x under the current model
  predict_all = fn [w b xs] -> (map (fn [x] -> (predict w b x)) xs)

  :: generic entry: fit from data, starting at w=b=0
  fit = fn [xs ys lr iters] -> (train [0 0] [0 0] xs ys lr iters)

  :: fit y = w·x + b to (1,3) (2,5) (3,7) (4,9); true w = 2, b = 1
  fit_demo = fn [iters] ->
    let xs = (tdata (tfromnats [1 [2 [3 [4 0]]]])) in
    let ys = (tdata (tfromnats [3 [5 [7 [9 0]]]])) in
    (train [0 0] [0 0] xs ys [0 200] iters)

  :: ===================================================================
  :: Perceptron — an online linear classifier for two classes {0,1}.
  :: Score s = w·x + b; class is 1 when s ≥ 0, else 0. The classic
  :: perceptron update nudges (w,b) by lr·(y − ŷ)·x on each misclassified
  :: point. No transcendental functions needed — pure signed arithmetic.
  :: ===================================================================
  pscore   = fn [w b x] -> (nadd (nmul w x) b)
  pclass   = fn [s] -> if (nlt s [0 0]) then 0 else 1            :: s ≥ 0 → 1 else 0
  ppredict = fn [w b x] -> (pclass (pscore w b x))
  perr     = fn [y p] -> if (y == p) then [0 0]                  :: signed (y − p) ∈ {−1,0,1}
                          else (if (y == 1) then [0 1000] else [1 1000])
  pepoch   = fn [w b xs ys lr] ->                                :: one pass over the data
    loop with [px = xs, py = ys, cw = w, cb = b] :
      if (px == 0) then [ cw cb ]
      else
        let p = (ppredict cw cb (head px)) in
        let e = (perr (head py) p) in
        again((tail px), (tail py),
              (nadd cw (nmul lr (nmul e (head px)))),
              (nadd cb (nmul lr e)))
    end
  ptrain   = fn [xs ys lr epochs] ->
    loop with [cw = [0 0], cb = [0 0], k = 0] :
      if (k == epochs) then [ cw cb ]
      else let wb = (pepoch cw cb xs ys lr) in again((head wb), (tail wb), +(k))
    end
  :: classify x>0 as 1, x<0 as 0 (linearly separable); returns the learned [w b]
  perceptron_demo = fn [epochs] ->
    let xs = [ [0 3000] [ [0 1000] [ [1 2000] [ [1 4000] 0 ] ] ] ] in
    let ys = [ 1 [ 1 [ 0 [ 0 0 ] ] ] ] in
    (ptrain xs ys [0 200] epochs)
  :: predictions of the demo model over its own training points (should be 1 1 0 0)
  perceptron_check = fn [epochs] ->
    let xs = [ [0 3000] [ [0 1000] [ [1 2000] [ [1 4000] 0 ] ] ] ] in
    let ys = [ 1 [ 1 [ 0 [ 0 0 ] ] ] ] in
    let wb = (ptrain xs ys [0 200] epochs) in
    (map (fn [x] -> (ppredict (head wb) (tail wb) x)) xs)

  :: ===================================================================
  :: k-means (k = 2) — unsupervised clustering of 1-D points. Each point
  :: is assigned to the nearest centroid (squared distance); centroids are
  :: recomputed as the mean of their members; iterate to convergence.
  :: ===================================================================
  kdist2   = fn [a b] -> let d = (nsub a b) in (nmul d d)
  knearest = fn [x c0 c1] -> if (nlt (kdist2 x c0) (kdist2 x c1)) then 0 else 1
  kmean    = fn [s n] -> if (n == 0) then [0 0] else (ndiv s (npos (mul n 1000)))
  kacc     = fn [xs c0 c1] ->                          :: → [s0 n0 s1 n1]
    loop with [px = xs, s0 = [0 0], n0 = 0, s1 = [0 0], n1 = 0] :
      if (px == 0) then [ s0 [ n0 [ s1 [ n1 0 ] ] ] ]
      else
        let x = (head px) in
        if ((knearest x c0 c1) == 0)
          then again((tail px), (nadd s0 x), +(n0), s1, n1)
          else again((tail px), s0, n0, (nadd s1 x), +(n1))
    end
  kstep    = fn [xs c0 c1] ->
    let a = (kacc xs c0 c1) in
    [ (kmean (nth a 0) (nth a 1)) (kmean (nth a 2) (nth a 3)) ]
  kmeans2  = fn [xs c0 c1 iters] ->
    loop with [a = c0, b = c1, k = 0] :
      if (k == iters) then [ a b ]
      else let c = (kstep xs a b) in again((head c), (tail c), +(k))
    end
  :: cluster {1,2,3, 10,11,12}; converges to centroids ≈ 2.0 and 11.0
  kmeans_demo = fn [iters] ->
    let xs = [ [0 1000] [ [0 2000] [ [0 3000] [ [0 10000] [ [0 11000] [ [0 12000] 0 ] ] ] ] ] ] in
    (kmeans2 xs [0 0] [0 9000] iters)

  :: ===================================================================
  :: k-NN (nearest-neighbour, k = 1) — instance-based classification.
  :: Returns the label of the closest training point to the query.
  :: ===================================================================
  knn1 = fn [xs ys q] ->
    loop with [px = xs, py = ys, bestd = [0 999999999], bestl = 0] :
      if (px == 0) then bestl
      else
        let d = (kdist2 q (head px)) in
        if (nlt d bestd) then again((tail px), (tail py), d, (head py))
        else again((tail px), (tail py), bestd, bestl)
    end
  :: train points {1,2 → 0} and {9,10 → 1}; classify a query
  knn_demo = fn [q] ->
    let xs = [ [0 1000] [ [0 2000] [ [0 9000] [ [0 10000] 0 ] ] ] ] in
    let ys = [ 0 [ 0 [ 1 [ 1 0 ] ] ] ] in
    (knn1 xs ys q)
end
