:: ===========================================================================
:: btree.lat — a B-tree: the read-optimized index family (DDIA, Ch. 3, p. 79).
::
:: Where an LSM-tree appends and merges, a B-tree keeps keys in a balanced,
:: high-fanout search tree and updates pages IN PLACE. Every leaf is the same
:: depth from the root, so lookups are O(log n) with a small, predictable height
:: — which is why B-trees dominate read-heavy, transactional stores. This is the
:: textbook (CLRS) immutable B-tree with PROACTIVE SPLITTING on the way down, so
:: insertion is a single root-to-leaf pass.   Arms prefixed `bt_`.
::
:: node = [ keys kids ];  keys = sorted list of [k v];  kids = list of children
:: (or 0 for a leaf). `t` is the minimum degree: a node holds t-1 .. 2t-1 keys.
:: ===========================================================================
import std
import dhash
core btree
  bt_new    = fn [_] -> [ 0 0 ]
  bt_keys   = fn [nd] -> (head nd)
  bt_kids   = fn [nd] -> (tail nd)
  bt_isleaf = fn [nd] -> ((tail nd) == 0)                    :: loobean 0 = leaf
  bt_full   = fn [nd t] -> ((len (bt_keys nd)) == (sub (mul 2 t) 1))

  :: functional update: xs with element i replaced by v — the prefix before i,
  :: then v, then everything after i (immutable trees update by rebuilding a path)
  bt_setnth = fn [xs i v] -> (append (take i xs) [ v (drop +(i) xs) ])

  :: number of keys whose key-part is strictly less than k (the child to descend)
  bt_findpos = fn [keys k] ->
    loop with [c = keys, i = 0] :
      if (c == 0) then i
      else if ((dh_klt (head (head c)) k) == 0) then again((tail c), +(i))
      else i
    end
  :: is k among this node's keys? loobean 0 = yes
  bt_haskey = fn [keys k] ->
    loop with [c = keys] :
      if (c == 0) then 1
      else if ((head (head c)) == k) then 0
      else again((tail c))
    end
  :: lookup k in this node's keys: 0 = absent, else [%val v]
  bt_findkey = fn [keys k] ->
    loop with [c = keys] :
      if (c == 0) then 0
      else if ((head (head c)) == k) then [ %val (tail (head c)) ]
      else again((tail c))
    end
  :: overwrite the value stored under an existing key, leaving order untouched
  bt_replace = fn [keys k v] -> (map (fn [e] -> if ((head e) == k) then [k v] else e) keys)
  :: insert [k v] into a sorted key list, keeping it sorted:
  :: walk with a reversed prefix accumulator until the first key GREATER than k,
  :: then stitch prefix ++ [k v] ++ rest (or append at the end if none is greater)
  bt_sortins = fn [keys k v] ->
    loop with [c = keys, acc = 0] :
      if (c == 0) then (append (reverse acc) [ [k v] 0 ])                 :: ran off the end: k is largest
      else if ((dh_klt k (head (head c))) == 0) then (append (reverse acc) [ [k v] c ])  :: first bigger key: splice here
      else again((tail c), [ (head c) acc ])                              :: still smaller: keep walking
    end

  :: search the whole tree: 0 = absent, else [%val v]
  bt_search = fn [tree k] ->
    loop with [node = tree] :
      let hit = (bt_findkey (bt_keys node) k) in
      if (hit == 0) then
        (if ((bt_isleaf node) == 0) then 0
         else again((nth (bt_kids node) (bt_findpos (bt_keys node) k))))
      else hit
    end

  :: split parent's full child at index i; the median moves up into parent
  bt_splitchild = fn [parent i t] ->
    let pk = (bt_keys parent) in
    let pkids = (bt_kids parent) in
    let ch = (nth pkids i) in                    :: the full child (2t-1 keys) being split
    let ck = (bt_keys ch) in
    let med = (nth ck (sub t 1)) in              :: its median key — this one moves UP
    let leaf = (bt_isleaf ch) in
    :: halves: keys 0..t-2 with the first t kids, and keys t..2t-2 with the rest
    :: (a leaf's halves keep kids = 0; the median belongs to NEITHER half)
    let left = [ (take (sub t 1) ck) (if (leaf == 0) then 0 else (take t (bt_kids ch))) ] in
    let right = [ (drop t ck) (if (leaf == 0) then 0 else (drop t (bt_kids ch))) ] in
    :: rebuild the parent: median spliced into its keys at position i, and the
    :: single child i replaced by the two halves (fanout grows by one)
    [ (append (take i pk) [ med (drop i pk) ])
      (append (take i pkids) [ left [ right (drop +(i) pkids) ] ]) ]

  :: insert into a node known not to be full (proactive split of full children)
  bt_insnonfull = fn [nd k v t] ->
    let keys = (bt_keys nd) in
    if ((bt_haskey keys k) == 0) then [ (bt_replace keys k v) (bt_kids nd) ]  :: k already here: overwrite in place
    else if ((bt_isleaf nd) == 0) then [ (bt_sortins keys k v) 0 ]            :: leaf: splice into the sorted keys
    else
      let i = (bt_findpos keys k) in            :: which child k belongs under
      let child = (nth (bt_kids nd) i) in
      if ((bt_full child t) == 0) then
        :: the child is full: split it NOW (the proactive step), which lifts its
        :: median into THIS node — then re-decide where k goes
        let nd2 = (bt_splitchild nd i t) in
        let med = (head (nth (bt_keys nd2) i)) in
        if (med == k) then [ (bt_replace (bt_keys nd2) k v) (bt_kids nd2) ]   :: k IS the lifted median: overwrite here
        else
          :: k > med goes into the right half (index i+1), else the left (i)
          let j = if ((dh_klt med k) == 0) then +(i) else i in
          [ (bt_keys nd2) (bt_setnth (bt_kids nd2) j (bt_insnonfull (nth (bt_kids nd2) j) k v t)) ]
      else [ keys (bt_setnth (bt_kids nd) i (bt_insnonfull child k v t)) ]    :: room below: descend directly

  :: top-level insert: if the root is full, grow a new root first (the only way a
  :: B-tree's height increases)
  bt_insert = fn [tree k v t] ->
    if ((bt_full tree t) == 0) then (bt_insnonfull (bt_splitchild [ 0 [ tree 0 ] ] 0 t) k v t)
    else (bt_insnonfull tree k v t)

  bt_build = fn [pairs t] -> (foldl (fn [tr p] -> (bt_insert tr (head p) (tail p) t)) (bt_new 0) pairs)

  :: ---- DELETION: the borrow/merge half of the B-tree (CLRS 18.3) ------------
  :: Deletion is harder than insertion because a node may underflow (drop below
  :: t-1 keys). The invariant that makes it a single downward pass mirrors the
  :: proactive split on insert: before we ever RECURSE into a child, we guarantee
  :: that child already has at least t keys, so it can afford to lose one. We do
  :: that by borrowing a key from a sibling, or — if both siblings are minimal —
  :: merging the child, a sibling, and their separator key into one full node.

  bt_nkeys = fn [nd] -> (len (bt_keys nd))
  :: largest / smallest [k v] in a subtree: walk to the rightmost / leftmost leaf
  bt_maxkey = fn [nd] ->
    loop with [x = nd] : if ((bt_isleaf x) == 0) then (last (bt_keys x)) else again((last (bt_kids x))) end
  bt_minkey = fn [nd] ->
    loop with [x = nd] : if ((bt_isleaf x) == 0) then (head (bt_keys x)) else again((head (bt_kids x))) end

  :: fuse a left child, the separator key between them, and a right child into one
  :: node of 2t-1 keys (used when neither side can spare a key)
  bt_merge = fn [left sep right] ->
    [ (append (bt_keys left) (append [ sep 0 ] (bt_keys right)))
      (if ((bt_isleaf left) == 0) then 0 else (append (bt_kids left) (bt_kids right))) ]

  :: rotate a key from the LEFT sibling i-1 through the parent into child i
  bt_borrowleft = fn [nd i] ->
    let keys = (bt_keys nd) in let kids = (bt_kids nd) in
    let child = (nth kids i) in let left = (nth kids (sub i 1)) in
    let lk = (bt_keys left) in let sep = (nth keys (sub i 1)) in  :: separator between left and child
    let lastk = (last lk) in                                      :: the donor: left's LARGEST key
    :: the separator drops DOWN to become child's new smallest key; the donor's
    :: rightmost subtree (if any) comes with it, prepended to child's kids
    let child2 = [ [ sep (bt_keys child) ]
                   (if ((bt_isleaf left) == 0) then 0
                    else [ (last (bt_kids left)) (bt_kids child) ]) ] in
    :: the left sibling shrinks by its last key (and, internally, its last kid)
    let left2 = [ (take (sub (len lk) 1) lk)
                  (if ((bt_isleaf left) == 0) then 0 else (take (sub (len (bt_kids left)) 1) (bt_kids left))) ] in
    :: the donor key rises into the parent as the new separator
    [ (bt_setnth keys (sub i 1) lastk)
      (bt_setnth (bt_setnth kids i child2) (sub i 1) left2) ]

  :: rotate a key from the RIGHT sibling i+1 through the parent into child i
  bt_borrowright = fn [nd i] ->
    let keys = (bt_keys nd) in let kids = (bt_kids nd) in
    let child = (nth kids i) in let right = (nth kids +(i)) in
    let rk = (bt_keys right) in let sep = (nth keys i) in  :: separator between child and right
    let firstk = (head rk) in                              :: the donor: right's SMALLEST key
    :: mirror image of borrowleft: the separator drops down as child's new
    :: largest key, and the donor's leftmost subtree is appended to child's kids
    let child2 = [ (append (bt_keys child) [ sep 0 ])
                   (if ((bt_isleaf right) == 0) then 0
                    else (append (bt_kids child) [ (head (bt_kids right)) 0 ])) ] in
    let right2 = [ (tail rk)
                   (if ((bt_isleaf right) == 0) then 0 else (tail (bt_kids right))) ] in
    [ (bt_setnth keys i firstk)
      (bt_setnth (bt_setnth kids i child2) +(i) right2) ]

  :: ensure child i has >= t keys: borrow from whichever sibling can spare one,
  :: else merge with a sibling (shrinking this node by one key and one child)
  bt_fill = fn [nd i t] ->
    let keys = (bt_keys nd) in let kids = (bt_kids nd) in let n = (len keys) in
    let leftok  = if (gt i 0) then (gte (bt_nkeys (nth kids (sub i 1))) t) else 1 in   :: lazy: sub only when i>0
    let rightok = if (lt i n) then (gte (bt_nkeys (nth kids +(i))) t) else 1 in
    if (leftok == 0) then (bt_borrowleft nd i)
    else if (rightok == 0) then (bt_borrowright nd i)
    else if (lt i n) then
      let merged = (bt_merge (nth kids i) (nth keys i) (nth kids +(i))) in
      [ (append (take i keys) (drop +(i) keys))
        (append (take i kids) [ merged (drop (add i 2) kids) ]) ]
    else
      let merged = (bt_merge (nth kids (sub i 1)) (nth keys (sub i 1)) (nth kids i)) in
      [ (append (take (sub i 1) keys) (drop i keys))
        (append (take (sub i 1) kids) [ merged (drop +(i) kids) ]) ]

  :: delete k from a node that already holds >= t keys (or is the root)
  bt_del = fn [nd k t] ->
    let keys = (bt_keys nd) in let kids = (bt_kids nd) in
    let i = (bt_findpos keys k) in
    let here = if ((lt i (len keys)) == 0) then ((head (nth keys i)) == k) else 1 in   :: 0 if k is in THIS node (lazy guard: nth only when i in range)
    if ((bt_isleaf nd) == 0) then
      (if (here == 0) then [ (append (take i keys) (drop +(i) keys)) 0 ] else nd)  :: leaf: drop it (or absent)
    else if (here == 0) then
      :: k is in an internal node: replace it with a neighbour key, then delete that
      (if (gte (bt_nkeys (nth kids i)) t) then
         let pred = (bt_maxkey (nth kids i)) in
         [ (bt_setnth keys i pred) (bt_setnth kids i (bt_del (nth kids i) (head pred) t)) ]
       else if (gte (bt_nkeys (nth kids +(i))) t) then
         let succ = (bt_minkey (nth kids +(i))) in
         [ (bt_setnth keys i succ) (bt_setnth kids +(i) (bt_del (nth kids +(i) ) (head succ) t)) ]
       else
         let merged = (bt_merge (nth kids i) (nth keys i) (nth kids +(i))) in
         let keys2 = (append (take i keys) (drop +(i) keys)) in
         let kids2 = (append (take i kids) [ merged (drop (add i 2) kids) ]) in
         [ keys2 (bt_setnth kids2 i (bt_del merged k t)) ])
    else
      :: k is not here: descend into child i, first guaranteeing it has >= t keys
      :: (a 0-key node is a transient root with a single child — descend straight in,
      :: it has no sibling to borrow/merge with and is collapsed at the top level)
      (if (gte (bt_nkeys (nth kids i)) t) then
         [ keys (bt_setnth kids i (bt_del (nth kids i) k t)) ]
       else if ((len keys) == 0) then
         [ keys (bt_setnth kids i (bt_del (nth kids i) k t)) ]
       else (bt_del (bt_fill nd i t) k t))

  :: top-level delete: if the root loses its last key, its only child becomes the
  :: new root (the single way a B-tree's height ever decreases)
  bt_delete = fn [tree k t] ->
    let r = (bt_del tree k t) in
    if (and ((bt_keys r) == 0) (not ((bt_kids r) == 0))) then (head (bt_kids r)) else r

  :: a ready-made tree so every example below runs as a one-liner: (bt_search (bt_sample 0) %kk)
  bt_sample = fn [_] ->
    (bt_build [[%mm 1] [[%dd 2] [[%aa 3] [[%zz 4] [[%kk 5] [[%gg 6] [[%pp 7] [[%cc 8] 0]]]]]]]] 2)

  :: in-order traversal -> sorted list of [k v] (a full index scan)
  bt_inorder = fn [nd] ->
    if ((bt_isleaf nd) == 0) then (bt_keys nd)
    else (bt_walk (bt_kids nd) (bt_keys nd))
  bt_walk = fn [kids keys] ->
    if (keys == 0) then (bt_inorder (head kids))
    else (append (bt_inorder (head kids))
                 (append [ (head keys) 0 ] (bt_walk (tail kids) (tail keys))))

  :: all leaves are equidistant from the root; this is that common height
  bt_height = fn [nd] -> if ((bt_isleaf nd) == 0) then 1 else +((bt_height (head (bt_kids nd))))

  :: RANGE SCAN [lo, hi] — the ordered scan a B-tree index is built for; here it
  :: rides the in-order traversal (a real B+-tree links the leaves to do the same
  :: without revisiting internal nodes)
  bt_range = fn [tree lo hi] ->
    (filter (fn [e] -> (and (not (dh_klt (head e) lo)) (not (dh_klt hi (head e)))))
            (bt_inorder tree))
  bt_count = fn [tree] -> (len (bt_inorder tree))
  bt_min   = fn [tree] -> (head (bt_inorder tree))
  bt_max   = fn [tree] -> (last (bt_inorder tree))
end
