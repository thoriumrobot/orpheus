:: ===========================================================================
:: wire.lat — encoding & schema evolution (DDIA, Ch. 4, pp. 116-128).
::
:: Two ideas that make rolling upgrades safe. (1) VARINT (LEB128): a natural is
:: packed into 7-bit groups, high bit = "more bytes follow", so small numbers
:: cost one byte — the encoding Protocol Buffers and Thrift use. (2) TAGGED
:: RECORDS + reader/writer schemas: every field carries a numeric tag, so a
:: reader can skip unknown (newer) fields for FORWARD compatibility and supply
:: defaults for missing (newer) fields for BACKWARD compatibility.  Arms `w_`.
::
:: record       = list of [tag value]      (what the writer serialized)
:: readerschema = list of [tag default]    (the fields the reader knows)
:: ===========================================================================
import std
core wire
  :: ---- varint (LEB128) ------------------------------------------------------
  w_varint = fn [n] ->
    loop with [x = n, acc = 0] :
      let b = (mod x 128) in
      let r = (div x 128) in
      if (r == 0) then (reverse [ b acc ])
      else again(r, [ (add b 128) acc ])
    end
  w_unvarint = fn [bytes] ->
    loop with [c = bytes, acc = 0, sh = 1] :
      if (c == 0) then acc
      else if (lt (head c) 128) then (add acc (mul (head c) sh))
      else again((tail c), (add acc (mul (sub (head c) 128) sh)), (mul sh 128))
    end
  :: total encoded size (bytes) of a natural under varint
  w_varlen = fn [n] -> (len (w_varint n))

  :: ---- tagged records -------------------------------------------------------
  :: encode a record as a flat byte stream: per field, varint(tag) ++ varint(value)
  w_encode = fn [record] ->
    (concat (map (fn [f] -> (append (w_varint (head f)) (w_varint (tail f)))) record))

  :: find a field by tag in a record: 0 = absent, else [%f value]
  w_find = fn [record tag] ->
    loop with [c = record] :
      if (c == 0) then 0
      else if ((head (head c)) == tag) then [ %f (tail (head c)) ]
      else again((tail c))
    end

  :: SCHEMA EVOLUTION: read a writer's record through a reader schema. Known
  :: fields take their value; missing fields take the schema default (backward
  :: compat); the writer's unknown extra tags are simply not requested (forward
  :: compat). Returns the reader's view as a list of [tag value].
  w_read = fn [record readerschema] ->
    (map (fn [s] ->
            let tag = (head s) in
            let found = (w_find record tag) in
            if (found == 0) then [ tag (tail s) ]
            else [ tag (tail found) ])
         readerschema)

  :: the writer tags the reader did not know about (and safely skipped)
  w_unknown = fn [record readerschema] ->
    (filter (fn [f] ->
               (not (member (head f) (map (fn [s] -> (head s)) readerschema))))
            record)

  :: ---- zigzag: signed integers as varint-friendly naturals ------------------
  :: A signed value is [sign mag] (sign 0 = +, 1 = -). Zigzag interleaves +/- so
  :: small magnitudes of either sign get small varints: 0,-1,1,-2,2 -> 0,1,2,3,4.
  :: (Two's-complement would make every negative a maximal 10-byte varint.)
  w_zigzag = fn [sv] ->
    if ((head sv) == 0) then (mul 2 (tail sv)) else (sub (mul 2 (tail sv)) 1)
  w_unzigzag = fn [u] ->
    if ((mod u 2) == 0) then [ 0 (div u 2) ] else [ 1 (div +(u) 2) ]

  :: ---- self-describing, length-delimited framing (Protobuf wire type 2) -----
  :: Each field is varint(tag) ++ varint(len) ++ len payload bytes. Because every
  :: field carries its length, a reader can PARSE and SKIP a field whose tag it has
  :: never seen — the actual basis of forward compatibility — and payloads nest.
  w_field = fn [tag bytes] -> (append (w_varint tag) (append (w_varint (len bytes)) bytes))
  :: encode a record given as a list of [tag payloadBytes]
  w_encrec = fn [fields] -> (concat (map (fn [f] -> (w_field (head f) (tail f))) fields))

  :: read one varint off the front: returns [value restBytes]
  w_readvarint = fn [bytes] ->
    loop with [c = bytes, acc = 0, sh = 1] :
      if (c == 0) then [ acc 0 ]
      else if (lt (head c) 128) then [ (add acc (mul (head c) sh)) (tail c) ]
      else again((tail c), (add acc (mul (sub (head c) 128) sh)), (mul sh 128))
    end
  :: parse framing back into a list of [tag payloadBytes] WITHOUT a schema — the
  :: reader skips fields by length, so unknown tags survive a round trip intact
  w_decrec = fn [bytes] ->
    loop with [c = bytes, acc = 0] :
      if (c == 0) then (reverse acc)
      else
        let tg = (w_readvarint c) in
        let ln = (w_readvarint (tail tg)) in
        again((drop (head ln) (tail ln)),
              [ [ (head tg) (take (head ln) (tail ln)) ] acc ])
    end

  :: a ready-made writer record [[tag value]...] (tags 1,2,5) and an evolved reader
  :: schema [[tag default]...] that knows tags 1,2,3 — so (w_read (w_sample 0)
  :: (w_sample_schema 0)) defaults the missing tag 3 and (w_unknown ...) reports tag 5.
  w_sample        = fn [_] -> [ [1 100] [ [2 200] [ [5 999] 0 ] ] ]
  w_sample_schema = fn [_] -> [ [1 0] [ [2 0] [ [3 7] 0 ] ] ]
end
