:: ===========================================================================
:: nn.lat — neural networks in Latte, over the signed fixed-point library.
::
:: A network is built from composable LAYERS, so architectures (including
:: residual/skip connections, as in ResNets) are ordinary data you can fold a
:: forward pass over.  A trainable 1-hidden-layer MLP comes with full
:: backpropagation (ReLU hidden, linear output, MSE loss) so the structure is
:: not just expressible but learnable.
::
:: Conventions
::   vector  = list of signed numbers            (e.g. [ [0 1000] [ [1 500] 0 ] ])
::   matrix  = list of rows, each a vector;  W is (outputs x inputs)
::   dense layer params = [W b]
::   MLP params         = [ W1 [ b1 [ W2 [ b2 0 ] ] ] ]
:: ===========================================================================
import num
core nn
  :: ---- vector / matrix algebra over signed numbers ------------------------
  vadd  = fn [a b] -> loop with [x = a, y = b, acc = 0] : if (x == 0) then (reverse acc) else again((tail x), (tail y), [ (nadd (head x) (head y)) acc ]) end
  vsub  = fn [a b] -> loop with [x = a, y = b, acc = 0] : if (x == 0) then (reverse acc) else again((tail x), (tail y), [ (nsub (head x) (head y)) acc ]) end
  vmul  = fn [a b] -> loop with [x = a, y = b, acc = 0] : if (x == 0) then (reverse acc) else again((tail x), (tail y), [ (nmul (head x) (head y)) acc ]) end
  vscale = fn [s v] -> (map (fn [vi] -> (nmul s vi)) v)
  vrelu = fn [v] -> (map (fn [vi] -> (nrelu vi)) v)
  vtanh = fn [v] -> (map (fn [vi] -> (ntanh vi)) v)
  matvec = fn [W x] -> (map (fn [row] -> (ndot row x)) W)
  mscale = fn [s M] -> (map (fn [row] -> (vscale s row)) M)
  msub  = fn [A B] -> loop with [a = A, b = B, acc = 0] : if (a == 0) then (reverse acc) else again((tail a), (tail b), [ (vsub (head a) (head b)) acc ]) end
  outer = fn [u v] -> (map (fn [ui] -> (vscale ui v)) u)         :: u (col) x v (row) -> matrix
  matTvec = fn [W d] ->                                          :: W^T . d  (W out x in, d out) -> in
    loop with [rows = W, ds = d, acc = 0] :
      if (rows == 0) then acc
      else let term = (vscale (head ds) (head rows)) in
        again((tail rows), (tail ds), if (acc == 0) then term else (vadd acc term))
    end

  :: ---- a dense (fully-connected) layer ------------------------------------
  dense = fn [W b x] -> (vadd (matvec W x) b)

  :: ---- the newer activations and normalizations ---------------------------
  :: fixed-point exp: e^x ~ (1 + x/16)^16 by four squarings, with x clamped to
  :: [-6, 6] so the approximation stays in range. Good enough for softmax,
  :: whose inputs are first shifted so the maximum is 0.
  nexp = fn [x] ->
    let cx = (nmax (nnegate (nint 6)) (nmin (nint 6) x)) in
    let y  = (nadd [0 1000] (ndiv cx (nint 16))) in
    let y2 = (nmul y y) in let y4 = (nmul y2 y2) in let y8 = (nmul y4 y4) in
    (nmul y8 y8)
  vsigmoid = fn [v] -> (map (fn [vi] -> (nsigmoid vi)) v)
  :: softmax: shift by the max (so exp's argument is <= 0), exponentiate, normalize
  vmax2 = fn [v] -> (foldl (fn [a vi] -> (nmax a vi)) (head v) (tail v))
  softmax = fn [v] ->
    let m  = (vmax2 v) in
    let es = (map (fn [vi] -> (nexp (nsub vi m))) v) in
    let z  = (nsum es) in
    if (nlt z [0 1]) then (map (fn [_] -> (ndiv [0 1000] (nint (len v)))) v)
    else (map (fn [e] -> (ndiv e z)) es)
  :: layer normalization: (x - mean) / std  (no learned gain/bias)
  nstd2 = fn [v] -> let m = (nmean v) in (nsqrt (nmean (map (fn [vi] -> let d = (nsub vi m) in (nmul d d)) v)))
  layernorm = fn [v] ->
    let m = (nmean v) in
    let s = (nstd2 v) in
    if (nlt s [0 1]) then (map (fn [vi] -> (nsub vi m)) v)
    else (map (fn [vi] -> (ndiv (nsub vi m) s)) v)
  :: 1-d convolution over a vector signal: kernel K (a vector), bias b; stride 1,
  :: valid padding — output length is len(x) - len(K) + 1.
  conv1d = fn [K b x] ->
    let k = (len K) in
    loop with [c = x, acc = 0] :
      if (lt (len c) k) then (reverse acc)
      else again((tail c), [ (nadd (ndot K (take k c)) b) acc ])
    end

  :: ---- composable layers: a network is a LIST of layers -------------------
  :: layer forms:  [%dense [W b]]  [%relu 0]  [%tanh 0]  [%sigmoid 0]
  ::               [%softmax 0]  [%layernorm 0]  [%conv1d [K b]]  [%res sublayers]
  layer_fwd = fn [L x] ->
    case (head L) of
      %dense   -> let p = (tail L) in (dense (head p) (head (tail p)) x) ;
      %relu    -> (vrelu x) ;
      %tanh    -> (vtanh x) ;
      %sigmoid -> (vsigmoid x) ;
      %softmax -> (softmax x) ;
      %layernorm -> (layernorm x) ;
      %conv1d  -> let p = (tail L) in (conv1d (head p) (head (tail p)) x) ;
      %res     -> (vadd (net_fwd (tail L) x) x) ;
      _        -> x
    end
  :: forward pass over a whole network (any architecture, ResNet-style included)
  net_fwd = fn [layers x] -> (foldl (fn [acc L] -> (layer_fwd L acc)) x layers)

  :: a residual block as a ready-made layer: y = relu(W2 . relu(W1 x + b1) + b2) + x
  resblock = fn [W1 b1 W2 b2] ->
    [ %res [ [%dense [ W1 [ b1 0 ] ] ] [ [%relu 0] [ [%dense [ W2 [ b2 0 ] ] ] [ [%relu 0] 0 ] ] ] ] ]

  :: ---- trainable 1-hidden-layer MLP: ReLU hidden, linear output -----------
  mlp_fwd = fn [p x] ->
    let W1 = (nth p 0) in let b1 = (nth p 1) in let W2 = (nth p 2) in let b2 = (nth p 3) in
    (dense W2 b2 (vrelu (dense W1 b1 x)))

  drelu = fn [z] -> if (nlt [0 0] z) then [0 1000] else [0 0]    :: 1 if z>0 else 0

  :: one SGD step on a single (x,y) example; MSE loss, gradient = (out - y)
  mlp_step = fn [p x y lr] ->
    let W1 = (nth p 0) in let b1 = (nth p 1) in let W2 = (nth p 2) in let b2 = (nth p 3) in
    let z1 = (dense W1 b1 x) in
    let h  = (vrelu z1) in
    let out = (dense W2 b2 h) in
    let dout = (vsub out y) in
    let dW2 = (outer dout h) in
    let dh  = (matTvec W2 dout) in
    let dz1 = (vmul dh (map (fn [zi] -> (drelu zi)) z1)) in
    let dW1 = (outer dz1 x) in
    [ (msub W1 (mscale lr dW1))
    [ (vsub b1 (vscale lr dz1))
    [ (msub W2 (mscale lr dW2))
    [ (vsub b2 (vscale lr dout)) 0 ] ] ] ]

  :: one pass over the dataset
  mlp_epoch = fn [p xs ys lr] ->
    loop with [px = xs, py = ys, cp = p] :
      if (px == 0) then cp
      else again((tail px), (tail py), (mlp_step cp (head px) (head py) lr))
    end
  mlp_train = fn [p xs ys lr epochs] ->
    loop with [cp = p, k = 0] : if (k == epochs) then cp else again((mlp_epoch cp xs ys lr), +(k)) end

  :: mean squared error of the model over the data (a signed number)
  mlp_loss = fn [p xs ys] ->
    let s = loop with [px = xs, py = ys, acc = [0 0]] :
              if (px == 0) then acc
              else let e = (vsub (mlp_fwd p (head px)) (head py)) in
                again((tail px), (tail py), (nadd acc (ndot e e)))
            end in
    (ndiv s (npos (mul (len xs) 1000)))

  :: ---- SEQUENCE layers: attention and the transformer block ----------------
  :: A sequence is a list of vectors (one per position). Layer forms:
  ::   [%attn [Wq [Wk [Wv 0]]]]   single-head scaled dot-product self-attention
  ::   [%seqdense [W b]]          a position-wise dense layer
  ::   [%lnorm 0]                 layer normalization at every position
  ::   [%seqres sublayers]        residual: seq_fwd(sub, xs) + xs, per position
  ::   [%pool 0]                  mean over positions (sequence -> one vector)
  :: A TRANSFORMER block is then ordinary data:
  ::   [ [%seqres [ [%attn [Wq [Wk [Wv 0]]]] 0 ]] [ [%lnorm 0]
  ::   [ [%seqres [ [%seqdense [W b]] 0 ]]        [ [%lnorm 0] 0 ] ] ] ]
  attn = fn [Wq Wk Wv xs] ->
    let qs = (map (fn [x] -> (matvec Wq x)) xs) in
    let ks = (map (fn [x] -> (matvec Wk x)) xs) in
    let vs = (map (fn [x] -> (matvec Wv x)) xs) in
    let d  = (nsqrt (nint (len (head qs)))) in
    (map (fn [q] ->
       let scores = (map (fn [kk] -> (ndiv (ndot q kk) d)) ks) in
       let w = (softmax scores) in
       loop with [ws = w, vv = vs, acc = 0] :
         if (ws == 0) then acc
         else let term = (vscale (head ws) (head vv)) in
           again((tail ws), (tail vv), if (acc == 0) then term else (vadd acc term))
       end) qs)
  seq_layer = fn [L xs] ->
    case (head L) of
      %attn     -> let p = (tail L) in (attn (head p) (head (tail p)) (head (tail (tail p))) xs) ;
      %seqdense -> let p = (tail L) in (map (fn [x] -> (dense (head p) (head (tail p)) x)) xs) ;
      %lnorm    -> (map (fn [x] -> (layernorm x)) xs) ;
      %seqres   -> let ys = (seq_fwd (tail L) xs) in
                   loop with [a = ys, b = xs, acc = 0] :
                     if (a == 0) then (reverse acc) else again((tail a), (tail b), [ (vadd (head a) (head b)) acc ])
                   end ;
      %pool     -> [ (vmean xs) 0 ] ;
      _         -> xs
    end
  seq_fwd = fn [layers xs] -> (foldl (fn [acc L] -> (seq_layer L acc)) xs layers)
  vmean = fn [xs] ->
    let s = loop with [c = xs, acc = 0] :
              if (c == 0) then acc
              else again((tail c), if (acc == 0) then (head c) else (vadd acc (head c)))
            end in
    (vscale (ndiv [0 1000] (nint (len xs))) s)
  :: run a sequence net that ends in %pool and read off the single vector
  seq_run = fn [layers xs] -> (head (seq_fwd layers xs))

  :: ---- a seeded builder: architectures from a spec, weights from an LCG ----
  :: rand: a linear congruential generator over naturals; randn maps it into a
  :: small signed weight in (-scale, +scale). randmat builds rows x cols of them.
  lcg = fn [seed] -> (mod (add (mul seed 1103515245) 12345) 2147483648)
  randn = fn [seed scale] ->
    let r = (mod seed 2001) in                       :: 0..2000
    [ (if (lt r 1001) then 0 else 1) (div (mul (mod r 1000) scale) 1000) ]
  randmat = fn [seed rows cols scale] ->
    loop with [i = 0, sd = seed, acc = 0] :
      if (i == rows) then (reverse acc)
      else
        let row = loop with [j = 0, sd2 = sd, racc = 0] :
                    if (j == cols) then [ (reverse racc) sd2 ]
                    else again(+(j), (lcg sd2), [ (randn sd2 scale) racc ])
                  end in
        again(+(i), (lcg (tail row)), [ (head row) acc ])
    end
  :: a ready-made transformer block over model width d, seeded
  block = fn [seed d] ->
    let Wq = (randmat seed d d 400) in
    let Wk = (randmat (add seed 7) d d 400) in
    let Wv = (randmat (add seed 13) d d 400) in
    let W  = (randmat (add seed 23) d d 400) in
    let b  = (map (fn [_] -> [0 0]) (range d)) in
    [ [%seqres [ [%attn [ Wq [ Wk [ Wv 0 ] ] ]] 0 ]]
    [ [%lnorm 0]
    [ [%seqres [ [%seqdense [ W [ b 0 ] ]] 0 ]]
    [ [%lnorm 0] 0 ] ] ] ]

  :: ---- demo: learn y = |x|, which needs a nonlinearity (two ReLU units) ----
  :: starts away from the solution; loss should fall sharply over the epochs.
  demo_data_x = fn [_] -> [ [ [1 3000] 0 ] [ [ [1 1000] 0 ] [ [ [0 1000] 0 ] [ [ [0 3000] 0 ] 0 ] ] ] ]
  demo_data_y = fn [_] -> [ [ [0 3000] 0 ] [ [ [0 1000] 0 ] [ [ [0 1000] 0 ] [ [ [0 3000] 0 ] 0 ] ] ] ]
  demo_init = fn [_] ->
    [ [ [ [0 500] 0 ] [ [ [1 300] 0 ] 0 ] ]            :: W1 (2 hidden x 1 input)
    [ [ [0 100] [ [1 100] 0 ] ]                        :: b1 (2)
    [ [ [ [0 400] [ [0 600] 0 ] ] 0 ]                  :: W2 (1 output x 2 hidden)
    [ [ [0 200] 0 ] 0 ] ] ] ]                          :: b2 (1)
  nn_demo = fn [epochs] -> (mlp_train (demo_init 0) (demo_data_x 0) (demo_data_y 0) [0 80] epochs)
  nn_demo_loss = fn [epochs] -> (mlp_loss (nn_demo epochs) (demo_data_x 0) (demo_data_y 0))
  nn_demo_pred = fn [epochs] ->
    let p = (nn_demo epochs) in (map (fn [x] -> (head (mlp_fwd p x))) (demo_data_x 0))
end
