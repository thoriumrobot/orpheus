:: ===========================================================================
:: dhash.lat — hashing & bit primitives for the data-intensive libraries.
::
:: We use a POLYNOMIAL (Horner) hash — h := (h*mult + byte + 1) mod 2^32 — which
:: needs only +, *, mod and disperses well enough for Bloom filters, consistent-
:: hashing rings, and Merkle trees. (std now provides bitwise ops, so an XOR-based
:: hash such as FNV-1a is now expressible too; the polynomial hash is kept for its
:: proven dispersion, while the bit-array primitives below DO use the new bitwise ops.)
:: A cord is an atom of little-endian bytes, so any atom (cord or number) hashes.
:: Used by: bloom, chash, merkle, hll.   Arms are prefixed `dh_`.
:: ===========================================================================
import std
core dhash
  :: 2^32, the hash modulus
  dh_mod = fn [_] -> 4294967296

  :: little-endian bytes of an atom, low byte first (0 -> the empty list)
  dh_bytes = fn [c] ->
    loop with [x = c, acc = 0] :
      if (x == 0) then (reverse acc)
      else again((div x 256), [ (mod x 256) acc ])
    end

  :: polynomial hash of an atom's bytes with a given multiplier and seed (mod 2^32)
  dh_hashm = fn [c mult seed] ->
    (foldl (fn [h b] -> (mod (add (mul h mult) (add b 1)) 4294967296)) seed (dh_bytes c))

  :: avalanche mix (Knuth multiplicative, constant = 2^32 / golden ratio): a
  :: one-byte input change spreads across all 32 bits, so near-identical keys
  :: (e.g. "k1","k2") no longer land on near-identical hashes
  dh_mix = fn [h] -> (mod (mul h 2654435761) 4294967296)

  :: two independent, well-mixed 32-bit hashes (different multiplier + seed)
  dh_h1 = fn [c] -> (dh_mix (dh_hashm c 131 2166136261))
  :: h2 is forced odd and non-zero so double hashing always strides
  dh_h2 = fn [c] -> (add (dh_mix (dh_hashm c 137 40503)) 1)

  :: range-reduce a 32-bit hash into [0, n) using the HIGH bits (multiply-shift,
  :: Lemire) — far more uniform than `mod n`, whose low bits are poorly mixed
  dh_idx = fn [h n] -> (div (mul (mod h 4294967296) n) 4294967296)

  :: a single combined hash folded into [0, n)
  dh_hash = fn [c n] -> (dh_idx (dh_h1 c) n)

  :: --- a bit-array packed into one (arbitrary-precision) natural --------------
  :: A Bloom filter IS a bit array, so these now lean on the bitwise vocabulary in
  :: std (bit/bor/shl/popcount), stating the intent directly instead of open-coding
  :: it with div/mod/pow.
  :: bit i of n: 1 if set, 0 if clear (NOT a loobean — 1 means "set")
  dh_bit = fn [n i] -> (bit n i)
  :: set bit i of n: OR in 1<<i (idempotent — setting an already-set bit is a no-op)
  dh_set = fn [n i] -> (bor n (shl 1 i))
  :: number of set bits (population count)
  dh_popcount = fn [n] -> (popcount n)

  :: lexicographic compare of two atoms by their bytes — a total order for keys.
  :: Loobean: 0 = (a < b), 1 = (a >= b).  Used to keep SSTables/B-trees sorted.
  dh_klt = fn [a b] ->
    loop with [xs = (dh_bytes a), ys = (dh_bytes b)] :
      if (xs == 0) then (if (ys == 0) then 1 else 0)
      else if (ys == 0) then 1
      else if (lt (head xs) (head ys)) then 0
      else if (gt (head xs) (head ys)) then 1
      else again((tail xs), (tail ys))
    end
end
