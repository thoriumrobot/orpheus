:: ===========================================================================
:: lsm.lat — an LSM-tree / SSTable storage engine (DDIA, Ch. 3, pp. 76-79).
::
:: Writes go to an in-memory MEMTABLE kept sorted by key; when it grows past a
:: threshold it is flushed as an immutable, sorted SEGMENT (an SSTable). Reads
:: consult the memtable, then segments newest-first, so the first hit wins.
:: Deletes write a TOMBSTONE. COMPACTION merges the sorted segments (a k-way
:: merge, newer value wins) and drops tombstones — the same mechanism a real
:: LSM engine (LevelDB, RocksDB, Cassandra) uses.   Arms prefixed `lsm_`.
::
:: store      = [ memtable [ segments threshold ] ]
:: memtable   = sorted list of [key valcell]
:: segment    = sorted list of [key valcell]   (immutable SSTable)
:: valcell    = [0 v] present  |  [1 0] tombstone
:: ===========================================================================
import std
import dhash
core lsm
  lsm_new    = fn [thresh] -> [ 0 [ 0 thresh ] ]
  lsm_mem    = fn [s] -> (head s)
  lsm_segs   = fn [s] -> (head (tail s))
  lsm_thresh = fn [s] -> (tail (tail s))

  :: sorted upsert into a sorted [key valcell] list (replace on equal key)
  lsm_ins = fn [lst k vc] ->
    loop with [c = lst, acc = 0] :
      if (c == 0) then (append (reverse acc) [ [k vc] 0 ])
      else let e = (head c) in let ek = (head e) in
        if (ek == k) then (append (reverse acc) [ [k vc] (tail c) ])
        else if ((dh_klt k ek) == 0) then (append (reverse acc) [ [k vc] c ])
        else again((tail c), [ e acc ])
    end

  :: flush the memtable into a fresh newest segment, clearing the memtable
  lsm_flush = fn [s] -> [ 0 [ [ (lsm_mem s) (lsm_segs s) ] (lsm_thresh s) ] ]
  lsm_maybeflush = fn [s] ->
    if (gt (len (lsm_mem s)) (lsm_thresh s)) then (lsm_flush s) else s

  lsm_put = fn [s k v] ->
    (lsm_maybeflush [ (lsm_ins (lsm_mem s) k [0 v]) [ (lsm_segs s) (lsm_thresh s) ] ])
  lsm_del = fn [s k] ->
    (lsm_maybeflush [ (lsm_ins (lsm_mem s) k [1 0]) [ (lsm_segs s) (lsm_thresh s) ] ])

  :: find a key in one segment: 0 = miss, else [%f valcell]
  lsm_findseg = fn [seg k] ->
    loop with [c = seg] :
      if (c == 0) then 0
      else if ((head (head c)) == k) then [ %f (tail (head c)) ]
      else again((tail c))
    end

  :: ZONE CHECK: could key k be in this sorted run at all? Since a run is sorted,
  :: its key range is [firstKey, lastKey]; if k falls outside, the run cannot hold
  :: it and the scan is skipped entirely. Loobean 0 = "k is within range, scan it".
  lsm_inzone = fn [seg k] ->
    if (seg == 0) then 1
    else (and (not (dh_klt k (head (head seg)))) (not (dh_klt (head (last seg)) k)))

  :: get: walk memtable then segments newest-first, but SKIP any run whose zone map
  :: rules k out (the first real read optimization in an LSM engine — a production
  :: store adds a per-segment Bloom filter for the runs the zone can't exclude).
  :: First live hit wins; a tombstone or no hit anywhere -> %absent.
  lsm_get = fn [s k] ->
    loop with [c = [ (lsm_mem s) (lsm_segs s) ]] :
      if (c == 0) then %absent
      else if ((lsm_inzone (head c) k) == 0) then
        let hit = (lsm_findseg (head c) k) in
        (if (hit == 0) then again((tail c))
         else if ((head (tail hit)) == 0) then [ %val (tail (tail hit)) ]
         else %absent)
      else again((tail c))
    end

  :: how many runs a read of k actually scans (zone map lets the rest be skipped) —
  :: exposed so the demo can show reads touching fewer than all the segments
  lsm_probed = fn [s k] ->
    (count (fn [layer] -> (lsm_inzone layer k)) [ (lsm_mem s) (lsm_segs s) ])

  :: merge two sorted segments; on equal key the FIRST (newer) wins
  lsm_merge = fn [a b] ->
    loop with [xs = a, ys = b, acc = 0] :
      if (xs == 0) then (append (reverse acc) ys)
      else if (ys == 0) then (append (reverse acc) xs)
      else let kx = (head (head xs)) in let ky = (head (head ys)) in
        if (kx == ky) then again((tail xs), (tail ys), [ (head xs) acc ])
        else if ((dh_klt kx ky) == 0) then again((tail xs), ys, [ (head xs) acc ])
        else again(xs, (tail ys), [ (head ys) acc ])
    end

  :: compaction: k-way merge of all segments (newest-first) into one, dropping
  :: tombstones — the steady-state job of an LSM background thread
  lsm_compact = fn [s] ->
    let segs = (lsm_segs s) in
    if (segs == 0) then s
    else let merged = (foldl (fn [acc seg] -> (lsm_merge acc seg)) (head segs) (tail segs)) in
      let live = (filter (fn [e] -> (head (tail e))) merged) in
      [ (lsm_mem s) [ [ live 0 ] (lsm_thresh s) ] ]

  :: how many immutable segments exist (read amplification)
  lsm_nsegs = fn [s] -> (len (lsm_segs s))

  :: the merged LIVE view: fold every layer newest-first so the newest write of
  :: each key wins (the logical state the engine presents over its segments)
  lsm_view = fn [s] ->
    let layers = [ (lsm_mem s) (lsm_segs s) ] in
    (foldl (fn [acc seg] -> (lsm_merge acc seg)) (head layers) (tail layers))
  :: present key/value pairs (tombstones dropped), sorted by key
  lsm_live = fn [s] -> (filter (fn [e] -> (head (tail e))) (lsm_view s))
  lsm_keys = fn [s] -> (map (fn [e] -> (head e)) (lsm_live s))

  :: RANGE SCAN [lo, hi] — a sorted-merge across memtable + segments, the query an
  :: SSTable's sorted order makes cheap (and a B-tree does too)
  lsm_range = fn [s lo hi] ->
    (filter (fn [e] -> (and (not (dh_klt (head e) lo)) (not (dh_klt hi (head e)))))
            (lsm_live s))

  :: ZONE MAP / sparse index summary: per segment, [minKey [maxKey count]]. This is
  :: the metadata `lsm_get`/`lsm_probed` consult to skip non-overlapping runs.
  lsm_segmeta = fn [s] ->
    (map (fn [seg] -> [ (head (head seg)) [ (head (last seg)) (len seg) ] ]) (lsm_segs s))

  :: a ready-made store so examples run as one-liners: (lsm_get (lsm_sample 0) %cherry)
  :: five writes (threshold 2, so several segments form), one overwrite, one delete.
  lsm_sample = fn [_] ->
    (lsm_del (lsm_put (lsm_put (lsm_put (lsm_put (lsm_put (lsm_new 2) %apple 1) %cherry 3)
                                        %elder 5) %grape 7) %cherry 33) %elder)
end
