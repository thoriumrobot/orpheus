:: ===========================================================================
:: std.lat — the Orpheus standard library, written in Latte.
:: Arithmetic on naturals is built from the single Loom primitive `+` (succ)
:: plus `dec` (Nock-style predecessor). Linked with `import std`.
:: ===========================================================================
core std
  :: --- arithmetic on naturals ---
  dec = fn [n] -> fast %dec loop with [i = 0] : if (+(i) == n) then i else again(+(i)) end
  add = fn [a b] -> fast %add loop with [x = a, i = b] : if (i == 0) then x else again(+(x), (dec i)) end
  sub = fn [a b] -> fast %sub loop with [x = a, i = b] : if (i == 0) then x else again((dec x), (dec i)) end
  mul = fn [a b] -> fast %mul loop with [acc = 0, i = b] : if (i == 0) then acc else again((add acc a), (dec i)) end
  lt  = fn [a b] -> fast %lt loop with [x = a, y = b] : if (y == 0) then 1 else if (x == 0) then 0 else again((dec x), (dec y)) end
  gt  = fn [a b] -> (lt b a)
  not = fn [b] -> if (b == 0) then 1 else 0
  lte = fn [a b] -> (not (gt a b))
  gte = fn [a b] -> (not (lt a b))
  and = fn [a b] -> if (a == 0) then b else 1
  or  = fn [a b] -> if (a == 0) then 0 else b
  min = fn [a b] -> if (lt a b) then a else b
  max = fn [a b] -> if (lt a b) then b else a
  mod = fn [a b] -> fast %mod loop with [x = a] : if (lt x b) then x else again((sub x b)) end
  div = fn [a b] -> fast %div loop with [q = 0, x = a] : if (lt x b) then q else again(+(q), (sub x b)) end

  :: --- cons lists (terminated by 0) ---
  len = fn [xs] -> loop with [c = xs, n = 0] : if (c == 0) then n else again((tail c), +(n)) end
  reverse = fn [xs] -> loop with [c = xs, acc = 0] : if (c == 0) then acc else again((tail c), [ (head c) acc ]) end
  append = fn [a b] -> loop with [c = (reverse a), acc = b] : if (c == 0) then acc else again((tail c), [ (head c) acc ]) end
  nth = fn [xs k] -> loop with [c = xs, i = k] : if (i == 0) then (head c) else again((tail c), (dec i)) end
  member = fn [x xs] -> loop with [c = xs] : if (c == 0) then 1 else if ((head c) == x) then 0 else again((tail c)) end
  range = fn [n] -> loop with [i = n, acc = 0] : if (i == 0) then acc else again((dec i), [ (dec i) acc ]) end

  :: --- higher-order ---
  map = fn [f xs] -> loop with [c = xs, acc = 0] : if (c == 0) then (reverse acc) else again((tail c), [ (f (head c)) acc ]) end
  filter = fn [f xs] -> loop with [c = xs, acc = 0] : if (c == 0) then (reverse acc) else if ((f (head c)) == 0) then again((tail c), [ (head c) acc ]) else again((tail c), acc) end
  foldl = fn [f z xs] -> loop with [c = xs, acc = z] : if (c == 0) then acc else again((tail c), (f acc (head c))) end

  :: --- more list utilities (windowing, pairing, sums) ---
  take = fn [n xs] -> loop with [k = n, c = xs, acc = 0] : if (k == 0) then (reverse acc) else if (c == 0) then (reverse acc) else again((dec k), (tail c), [ (head c) acc ]) end
  drop = fn [n xs] -> loop with [k = n, c = xs] : if (k == 0) then c else if (c == 0) then 0 else again((dec k), (tail c)) end
  last = fn [xs] -> loop with [c = xs] : if ((tail c) == 0) then (head c) else again((tail c)) end
  sum = fn [xs] -> (foldl (fn [a v] -> (add a v)) 0 xs)
  replicate = fn [n v] -> loop with [k = n, acc = 0] : if (k == 0) then acc else again((dec k), [ v acc ]) end
  zip = fn [a b] -> loop with [x = a, y = b, acc = 0] : if (x == 0) then (reverse acc) else if (y == 0) then (reverse acc) else again((tail x), (tail y), [ [ (head x) (head y) ] acc ]) end
  foldr = fn [f z xs] -> (foldl (fn [a v] -> (f v a)) z (reverse xs))
  :: --- general-purpose helpers (a fuller standard library) -----------------
  :: predicate combinators (predicates return the loobean 0 = true)
  any   = fn [f xs] -> loop with [c = xs] : if (c == 0) then 1 else if ((f (head c)) == 0) then 0 else again((tail c)) end
  all   = fn [f xs] -> loop with [c = xs] : if (c == 0) then 0 else if ((f (head c)) == 0) then again((tail c)) else 1 end
  count = fn [f xs] -> loop with [c = xs, n = 0] : if (c == 0) then n else if ((f (head c)) == 0) then again((tail c), +(n)) else again((tail c), n) end
  elem  = fn [x xs] -> (member x xs)
  :: numeric aggregates over a non-empty list of naturals
  maximum = fn [xs] -> (foldl (fn [a v] -> (max a v)) (head xs) (tail xs))
  minimum = fn [xs] -> (foldl (fn [a v] -> (min a v)) (head xs) (tail xs))
  :: index of the (first) maximum element
  argmax = fn [xs] ->
    loop with [c = (tail xs), i = 1, bi = 0, bv = (head xs)] :
      if (c == 0) then bi
      else if (lt bv (head c)) then again((tail c), +(i), i, (head c))
      else again((tail c), +(i), bi, bv) end
  :: pair each element with its index: [x0 x1 ..] -> [[0 x0] [1 x1] ..]
  enumerate = fn [xs] -> loop with [c = xs, i = 0, acc = 0] : if (c == 0) then (reverse acc) else again((tail c), +(i), [ [ i (head c) ] acc ]) end
  :: scanl: prefix folds, [z, f z x0, f (f z x0) x1, ..]
  scanl = fn [f z xs] -> loop with [c = xs, acc = z, out = [ z 0 ] ] : if (c == 0) then (reverse out) else again((tail c), (f acc (head c)), [ (f acc (head c)) out ]) end
  :: flatten a list of lists
  concat = fn [xss] -> (foldr (fn [a b] -> (append a b)) 0 xss)
  :: remove duplicate elements, keeping the first occurrence (structural equality)
  nub = fn [xs] -> (reverse (foldl (fn [acc x] -> if ((member x acc) == 0) then acc else [ x acc ]) 0 xs))

  :: --- association lists: a key->value map as a list of [key value] pairs ------
  :: a pair is [k v] (a cell); the value is its tail.
  :: the value for `k` (the first match), or default `d` if `k` is absent
  aget = fn [al k d] ->
    loop with [c = al] :
      if (c == 0) then d
      else if ((head (head c)) == k) then (tail (head c))
      else again((tail c))
    end
  :: 0 if key `k` is present
  ahas = fn [al k] -> loop with [c = al] : if (c == 0) then 1 else if ((head (head c)) == k) then 0 else again((tail c)) end
  :: insert or replace the binding for `k` (preserves order; updates in place)
  aput = fn [al k v] ->
    if ((ahas al k) == 0) then
      (map (fn [p] -> if ((head p) == k) then [ k v ] else p) al)
    else (append al [ [ k v ] 0 ])
  :: remove the binding for `k`
  adel = fn [al k] -> (filter (fn [p] -> if ((head p) == k) then 1 else 0) al)
  :: all keys / all values, in order
  akeys = fn [al] -> (map (fn [p] -> (head p)) al)
  avals = fn [al] -> (map (fn [p] -> (tail p)) al)

  :: --- cords (text): atoms read as little-endian UTF-8 bytes -----------------
  :: These arms make Latte self-sufficient for TEXT-PRODUCING tools: build any
  :: string — SVG, HTML, a report — as a cord and return it (tag it %svg/%html
  :: and the System embeds it as a live object; see docs/the-system.md).
  :: integer power by binary (squaring) exponentiation: O(log e) multiplies, not e.
  :: Hot path for bloom bit masks (pow 2 i) and cord shifts (pow 256 len), so the
  :: whole database, bloom filter, and string builder get faster.
  pow = fn [b e] -> loop with [acc = 1, base = b, i = e] :
    if (i == 0) then acc
    else again((if ((mod i 2) == 1) then (mul acc base) else acc),
               (if (lt i 2) then base else (mul base base)),
               (div i 2))
  end
  :: byte length of a cord (0 for the empty cord / nil)
  bytelen = fn [c] -> loop with [x = c, n = 0] : if (x == 0) then n else again((div x 256), +(n)) end
  :: concatenate two cords:  %ab `cat` %cd  ->  %abcd
  cat = fn [a b] -> if (a == 0) then b else (add a (mul b (pow 256 (bytelen a))))
  :: concatenate a list of cords
  catall = fn [cs] -> (foldl (fn [a c] -> (cat a c)) 0 cs)
  :: balanced concatenation — same bytes as catall, but O(n log n) not O(n^2).
  :: Each `cat` shifts the right cord by the LEFT cord's length (a big-integer
  :: multiply), so a left fold over many/long cords is quadratic. Pairing adjacent
  :: cords and halving the list repeatedly keeps the shifts small. Prefer this when
  :: assembling large strings (e.g. an HTML page with an inline SVG).
  catpairs = fn [cs] ->
    loop with [c = cs, acc = 0] :
      if (c == 0) then (reverse acc)
      else if ((tail c) == 0) then (reverse [ (head c) acc ])
      else again((tail (tail c)), [ (cat (head c) (head (tail c))) acc ])
    end
  catbal = fn [cs] ->
    loop with [c = cs] :
      if (c == 0) then 0
      else if ((tail c) == 0) then (head c)
      else again((catpairs c))
    end
  :: join a list of cords with a separator cord
  joincords = fn [sep cs] ->
    if (cs == 0) then 0
    else (foldl (fn [a c] -> (cat (cat a sep) c)) (head cs) (tail cs))
  :: decimal text of a natural:  (numtext 1234) -> %1234
  numtext = fn [n] ->
    if (n == 0) then 48
    else loop with [x = n, acc = 0] :
      if (x == 0) then acc
      else again((div x 10), (cat (add 48 (mod x 10)) acc))
    end
  :: fixed-point text, thousandths:  (fixtext 1500) -> %1.500
  fixtext = fn [v] ->
    let f = (mod v 1000) in
    let pad = if (lt f 10) then %00 else if (lt f 100) then %0 else 0 in
    (catall [ (numtext (div v 1000)) [ %. [ pad [ (numtext f) 0 ] ] ] ])
end
