:: ===========================================================================
:: db.lat — a database assembled from the data-intensive parts, deep enough to
:: show the techniques the way Designing Data-Intensive Applications presents them.
:: It is the through-line of DDIA Parts I–II in one module. The layers:
::
::   STORAGE (Ch.3)        an LSM-tree holds primary key -> a VERSION CHAIN.
::   DURABILITY (Ch.3)     every mutation is appended to a write-ahead log first;
::                         db_recover replays the log onto a fresh db (crash recovery).
::   NEGATIVE LOOKUPS(Ch3) a Bloom filter answers "definitely absent" before any read.
::   SECONDARY INDEX (Ch3) a second LSM maps an indexed field value -> primary keys,
::                         kept correct as rows are updated and deleted.
::   ENCODING (Ch.4)       values are tagged records, evolved through a reader schema.
::   PARTITIONING (Ch.6)   a consistent-hash ring routes a key to its shard; the
::                         local-vs-global secondary-index trade-off is spelled out.
::   MVCC (Ch.7)           each key keeps a chain of [ts value] versions. A reader at
::                         snapshot timestamp T sees the newest version with ts <= T —
::                         a consistent snapshot, and time-travel for free.
::   TRANSACTIONS (Ch.7)  two isolation levels on the MVCC versions: SNAPSHOT
::                         ISOLATION (db_commit_si, write-write conflicts only —
::                         and so permits WRITE SKEW) and SERIALIZABLE via optimistic
::                         read-set validation (db_commit, which closes write skew).
::                         db_skew_si / db_skew_ser run the doctors-on-call anomaly.
::   LEADERLESS REPL.(Ch5) clu_* : N replicas, quorum W/R, version-vector conflict
::                         detection (siblings) via the MV-Register CRDT, and read repair.
::   ATOMIC COMMIT (Ch.9)  tpc_* : two-phase commit — a transaction across shards
::                         commits iff every participant votes yes.
::
:: A db value is [ store index bloom idxtag rschema ts wal ].
:: A record is a wire field list [ [tag value] .. 0 ]. A version chain is a list of
:: [ts value] pairs, newest first; value is a record or the atom %tomb (a deletion).
:: ===========================================================================
import std
import num
import dhash
import lsm
import bloom
import wire
import chash
import vclock
import crdt
import quorum
core db
  :: ---- the db tuple and its accessors --------------------------------------
  db_make = fn [store index bloom idxtag rschema ts wal] ->
    [ store [ index [ bloom [ idxtag [ rschema [ ts [ wal 0 ] ] ] ] ] ] ]
  db_store   = fn [d] -> (nth d 0)
  db_index   = fn [d] -> (nth d 1)
  db_bloom   = fn [d] -> (nth d 2)
  db_idxtag  = fn [d] -> (nth d 3)
  db_rschema = fn [d] -> (nth d 4)
  db_ts      = fn [d] -> (nth d 5)
  db_wal     = fn [d] -> (nth d 6)

  :: open a database: index field `idxtag`, evolve reads through `rschema` (0 = none),
  :: LSM flush threshold `thresh`.
  db_open = fn [idxtag rschema thresh] ->
    (db_make (lsm_new thresh) [ [ idxtag (lsm_new thresh) ] 0 ] (bloom_make 1024 4) idxtag rschema 0 0)

  :: ---- MVCC version chains (Ch.7) ------------------------------------------
  :: a chain is [ [ts val] .. ] newest first. The value visible at snapshot `ts` is
  :: the newest version stamped at or before it.
  chain_at = fn [chain ts] ->
    loop with [c = chain] :
      if (c == 0) then %none
      else if (lte (head (head c)) ts) then (tail (head c))
      else again((tail c))
    end
  :: the latest commit timestamp on a chain (0 if empty) — the per-key version that
  :: serializable validation compares against a transaction's snapshot
  chain_ts = fn [chain] -> if (chain == 0) then 0 else (head (head chain))

  :: ---- tiny helpers --------------------------------------------------------
  :: the value of field `tag` in a record, or %none if the record lacks it
  db_field = fn [rec tag] -> let f = (w_find rec tag) in if (f == 0) then %none else (tail f)
  :: unwrap an lsm result: [%val v] -> v, %absent -> 0
  db_unwrap = fn [g] -> if (g == %absent) then 0 else (tail g)
  :: the version chain stored under a key (0 if the key was never written)
  db_chain = fn [d pk] -> (db_unwrap (lsm_get (db_store d) pk))
  :: the latest commit timestamp for a key (0 if absent)
  db_keyts = fn [d pk] -> (chain_ts (db_chain d pk))

  :: secondary-index posting lists for ONE field's LSM: a field value -> list of pks
  db_idxget = fn [index fv] -> (db_unwrap (lsm_get index fv))
  db_addpk  = fn [pks pk] -> if ((member pk pks) == 0) then pks else [ pk pks ]
  db_delpk  = fn [pks pk] -> (filter (fn [x] -> if (x == pk) then 1 else 0) pks)
  db_idxadd = fn [index fv pk] -> (lsm_put index fv (db_addpk (db_idxget index fv) pk))
  db_idxdel = fn [index fv pk] -> (lsm_put index fv (db_delpk (db_idxget index fv) pk))

  :: ---- the per-field index MAP --------------------------------------------
  :: the `index` slot is an assoc list of [field lsm]: a database can carry SEVERAL
  :: secondary indexes, one posting-list LSM per indexed field. The primary index is on
  :: the field `idxtag` (always present); more are added with db_addindex.
  db_imapget = fn [imap field] ->
    (foldl (fn [acc e] -> if ((head e) == field) then (tail e) else acc) 0 imap)
  db_imapset = fn [imap field lsm] ->
    (map (fn [e] -> if ((head e) == field) then [ field lsm ] else e) imap)
  db_imapfields = fn [imap] -> (map (fn [e] -> (head e)) imap)
  db_imaphas    = fn [imap field] -> (member field (db_imapfields imap))   :: 0 if indexed
  db_imapcompact= fn [imap] -> (map (fn [e] -> [ (head e) (lsm_compact (tail e)) ]) imap)

  :: reindex `pk` in ONE field's index for a change oldrec -> newrec: drop the old
  :: posting, add the new one (%none/%tomb skips that side).
  db_reindex1 = fn [imap field pk oldrec newrec] ->
    let lsm   = (db_imapget imap field),
        oldfv = if (or (oldrec == %none) (oldrec == %tomb)) then %none else (db_field oldrec field),
        newfv = if (or (newrec == %none) (newrec == %tomb)) then %none else (db_field newrec field),
        l1    = if (oldfv == %none) then lsm else (db_idxdel lsm oldfv pk),
        l2    = if (newfv == %none) then l1  else (db_idxadd l1 newfv pk) in
    (db_imapset imap field l2)
  :: reindex `pk` across EVERY indexed field (the maintenance every write performs)
  db_reindex = fn [imap pk oldrec newrec] ->
    (foldl (fn [m field] -> (db_reindex1 m field pk oldrec newrec)) imap (db_imapfields imap))

  :: ---- the core state transition (no logging) ------------------------------
  :: append a new version to `pk` at timestamp `ts`, refresh the Bloom filter, and
  :: keep the secondary index in step. `op` is %put (val is the record) or %del.
  db_apply = fn [d op pk val ts] ->
    let oldchain = (db_chain d pk),
        oldrec = (chain_at oldchain (db_ts d)),
        storeval = if (op == %put) then val else %tomb,
        store2 = (lsm_put (db_store d) pk [ [ts storeval] oldchain ]),
        bloom2 = (bloom_add (db_bloom d) pk),
        index2 = (db_reindex (db_index d) pk oldrec storeval) in
    (db_make store2 index2 bloom2 (db_idxtag d) (db_rschema d) ts (db_wal d))

  :: ---- durability: write-ahead log (Ch.3) ----------------------------------
  :: a log entry is [ op pk val ts ]. We append to the log BEFORE applying, so the
  :: log is the source of truth; the in-memory state is a cache the log can rebuild.
  db_logentry = fn [d e] ->
    (db_make (db_store d) (db_index d) (db_bloom d) (db_idxtag d) (db_rschema d) (db_ts d)
             (append (db_wal d) [ e 0 ]))

  :: ---- writes (log, then apply) --------------------------------------------
  db_put = fn [d pk rec] ->
    let ts1 = (add (db_ts d) 1) in
    (db_apply (db_logentry d [ %put [ pk [ rec [ ts1 0 ] ] ] ]) %put pk rec ts1)
  :: delete: append a tombstone version (MVCC keeps the history). The Bloom filter
  :: cannot un-set a bit, so a deleted key may still test "possibly present" — at
  :: worst one wasted read of a chain whose visible version is the tombstone.
  db_delete = fn [d pk] ->
    let ts1 = (add (db_ts d) 1) in
    (db_apply (db_logentry d [ %del [ pk [ %tomb [ ts1 0 ] ] ] ]) %del pk %tomb ts1)

  :: CRASH RECOVERY: replay a write-ahead log onto a fresh db. Replaying in order
  :: reconstructs every chain, the index, the Bloom filter, and the ts counter —
  :: so (db_recover (db_open ..) (db_wal d)) reads identically to `d`.
  db_recover = fn [d0 wal] ->
    (foldl (fn [d e] -> (db_apply d (nth e 0) (nth e 1) (nth e 2) (nth e 3))) d0 wal)

  :: ---- reads (MVCC snapshot) -----------------------------------------------
  :: read `pk` as of snapshot timestamp `ts`. The Bloom filter shortcuts a key that
  :: was never written; a tombstone or a not-yet-existing version reads as %absent.
  db_getat = fn [d pk ts] ->
    if ((bloom_test (db_bloom d) pk) == 1) then %absent
    else let chain = (db_chain d pk) in
      if (chain == 0) then %absent
      else let v = (chain_at chain ts) in
        if (or (v == %none) (v == %tomb)) then %absent
        else if ((db_rschema d) == 0) then [ %rec v ] else [ %rec (w_read v (db_rschema d)) ]
  :: a point read at the latest committed snapshot
  db_get = fn [d pk] -> (db_getat d pk (db_ts d))
  :: did the Bloom filter skip the store entirely for this key? (0 = skipped)
  db_skipped = fn [d pk] -> (bloom_test (db_bloom d) pk)
  :: the full version history of a key (newest first) — MVCC made visible
  db_history = fn [d pk] -> (db_chain d pk)

  :: secondary-index query on a SPECIFIC indexed field: every live record whose `field` = fv
  db_queryon = fn [d field fv] ->
    (map (fn [pk] -> [ pk (db_get d pk) ]) (db_idxget (db_imapget (db_index d) field) fv))
  :: secondary-index query on the PRIMARY field (idxtag): every live record whose value = fv
  db_query = fn [d fv] -> (db_queryon d (db_idxtag d) fv)
  :: render the primary keys of a result set as a space-separated cord (for the CLI)
  db_keytext = fn [es] -> (catall (map (fn [e] -> (catall [ (head e) " " 0 ])) es))
  :: primary-key range scan [lo, hi], each key resolved to its visible record
  db_range = fn [d lo hi] ->
    (map (fn [e] -> [ (head e) (db_get d (head e)) ]) (lsm_range (db_store d) lo hi))
  :: merge LSM segments in the primary store and the secondary index
  db_compact = fn [d] ->
    (db_make (lsm_compact (db_store d)) (db_imapcompact (db_index d)) (db_bloom d)
             (db_idxtag d) (db_rschema d) (db_ts d) (db_wal d))

  :: ---- query / analytics layer (relational-style, executed as compiled Latte) ---
  :: These compose over the storage engine: every operator takes the ENTRY LIST that
  :: db_query / db_range / db_scan produce (each entry [pk [%rec fields]]) and does
  :: scan -> filter -> aggregate -> group -> order. Because db_pluck projects a field
  :: into a plain numeric list, the result drops straight into the statistics library
  :: (lib/stats.lat), the plotter (lib/plot.lat), and ML training — the same path
  :: findb.lat hand-rolls for one series, generalized to any database and any field.

  :: every live record with primary key in [lo,hi] — the scan that feeds analytics
  db_scan  = fn [d lo hi] -> (db_range d lo hi)
  :: the value of field `tag` in an entry
  db_fieldof = fn [e tag] -> (db_field (db_rec e) tag)
  :: keep entries satisfying predicate `p` (Latte convention: p returns 0 to KEEP)
  db_where = fn [p es] -> (filter p es)
  :: project field `tag` of every entry into a plain list — the bridge to stats/plot/ML
  db_pluck = fn [tag es] -> (map (fn [e] -> (db_fieldof e tag)) es)
  :: same, but lifted to signed fixed-point (num.lat) — the bridge to the statistics and
  :: ML libraries, which compute on [sign mag] values (st_mean, st_std, regression, ...)
  db_npluck = fn [tag es] -> (map (fn [e] -> (nint (db_fieldof e tag))) es)

  :: ---- reductions over a plain value list (the kernel of the column aggregates) -------
  :: These fold a list of values the caller has already projected (e.g. with db_pluck). They
  :: are the single source of truth for sum/min/max, so anything holding a column — including
  :: a chart that needs the extent of a series for axis scaling — reduces it through the DB
  :: rather than re-implementing the fold.
  db_lsum = fn [xs] -> (foldl (fn [a v] -> (add a v)) 0 xs)
  db_lmin = fn [xs] -> (foldl (fn [a v] -> (min a v)) (head xs) (tail xs))
  db_lmax = fn [xs] -> (foldl (fn [a v] -> (max a v)) (head xs) (tail xs))

  :: aggregations over field `tag` of an entry list (integer fields)
  db_count = fn [es] -> (len es)
  db_sum   = fn [tag es] -> (db_lsum (db_pluck tag es))
  db_min   = fn [tag es] -> (db_lmin (db_pluck tag es))
  db_max   = fn [tag es] -> (db_lmax (db_pluck tag es))
  db_avg   = fn [tag es] -> (div (db_sum tag es) (max 1 (db_count es)))

  :: ---- column STATISTICS over a numeric field (signed fixed-point, num.lat) ------
  :: The database computes the mean / variance / standard deviation of a field itself, so
  :: the ML pipeline can standardize features without leaving the store.  Population
  :: variance (matches lib/stats.lat's st_var/st_std), built on db_npluck + num.lat.
  db_nmean = fn [tag es] -> (nmean (db_npluck tag es))
  db_nvar  = fn [tag es] -> let xs = (db_npluck tag es), m = (nmean xs) in
                            (nmean (map (fn [x] -> (nmul (nsub x m) (nsub x m))) xs))
  db_nstd  = fn [tag es] -> (nsqrt (db_nvar tag es))
  :: per-field [mean std] for a list of fields — the standardization statistics, computed
  :: column-by-column straight from the records (no transpose needed).
  db_colstats = fn [fields es] -> (map (fn [f] -> [ (db_nmean f es) (db_nstd f es) ]) fields)

  :: ---- DB <-> TENSOR / design-matrix bridge -------------------------------------
  :: Project a record's chosen fields to a fixed-point feature ROW; a set of records to a
  :: design MATRIX (a list of feature rows — exactly what lib/fin.lat's regression eats);
  :: and to a TENSOR [ [rows cols] flatdata ] that lib/tensor.lat operates on (tmatmul,
  :: tdot, tscale...).  Field values are lifted to [sign mag] x1000, the numeric
  :: representation shared by the statistics and tensor libraries.
  db_frow   = fn [fields e]  -> (map (fn [f] -> (nint (db_fieldof e f))) fields)
  db_matrix = fn [fields es] -> (map (fn [e] -> (db_frow fields e)) es)
  db_tensor = fn [fields es] ->
    [ [ (len es) [ (len fields) 0 ] ]
      (foldl (fn [acc e] -> (append acc (db_frow fields e))) 0 es) ]
  :: standardize one design-matrix row against per-column [mean std] (z-score; a zero-std
  :: column passes through mean-centred, matching st_zscore).
  db_zrow = fn [stats row] ->
    loop with [ss = stats, rs = row, out = 0] :
      if (ss == 0) then (reverse out)
      else let ms = (head ss), x = (head rs), m = (head ms), s = (tail ms) in
        again((tail ss), (tail rs),
              [ (if (nlt s [0 1]) then (nsub x m) else (ndiv (nsub x m) s)) out ])
    end
  :: the standardized design matrix straight from the database: project + z-score in one
  :: step against the (train-only) column statistics.
  db_zmatrix = fn [fields es stats] -> (map (fn [r] -> (db_zrow stats r)) (db_matrix fields es))

  :: ---- ML conveniences: the walk-forward split and train-only standardization ---------
  :: split a record list into [train test] at position `n` (the first n are train).
  db_split  = fn [n es] -> [ (take n es) [ (drop n es) 0 ] ]
  :: the standardized design matrix using statistics fit ON THE TRAINING ROWS ONLY (the first
  :: `split` records) — the correct discipline (no test-set leakage), done entirely in the
  :: database. This is the one call that turns stored records into a model-ready feature matrix.
  db_ztrain = fn [fields es split] -> (db_zmatrix fields es (db_colstats fields (take split es)))

  :: order entries by field `tag` (ascending, then a descending form) and take the top n
  db_order  = fn [tag es] -> (sortby (fn [a b] -> (lte (db_fieldof a tag) (db_fieldof b tag))) es)
  db_orderd = fn [tag es] -> (sortby (fn [a b] -> (lte (db_fieldof b tag) (db_fieldof a tag))) es)
  db_topn   = fn [n tag es] -> (take n (db_orderd tag es))

  :: GROUP BY field `gtag`: distinct group values (first-seen order), then bucket
  db_distinct = fn [tag es] ->
    (foldl (fn [acc e] -> let v = (db_fieldof e tag) in
             if ((member v acc) == 0) then acc else (append acc [ v 0 ])) 0 es)
  db_group1 = fn [tag v es] -> (filter (fn [e] -> ((db_fieldof e tag) == v)) es)
  db_groups = fn [tag es] -> (map (fn [v] -> [ v (db_group1 tag v es) ]) (db_distinct tag es))
  :: group by `gtag`, summing field `atag` per group -> list of [groupval total]
  db_groupsum = fn [gtag atag es] ->
    (map (fn [g] -> [ (head g) (db_sum atag (tail g)) ]) (db_groups gtag es))
  :: group by `gtag`, averaging field `atag` per group -> list of [groupval mean]
  db_groupavg = fn [gtag atag es] ->
    (map (fn [g] -> [ (head g) (db_avg atag (tail g)) ]) (db_groups gtag es))

  :: GROUP BY / SUM over the host's explicit live-key list (used by the durable
  :: database, whose arbitrary keys don't form a cord range): each key resolved to
  :: its visible record, grouped on field `gtag`, summing field `atag`.
  db_aggkeys = fn [d ks gtag atag] -> (db_groupsum gtag atag (map (fn [k] -> (db_entryk d k)) ks))
  db_aggrow  = fn [r] -> (catall [ (head r) ": " (numtext (tail r)) "\n" 0 ])
  db_aggtext = fn [d ks gtag atag] -> (catall (map (fn [r] -> (db_aggrow r)) (db_aggkeys d ks gtag atag)))

  :: ---- index-aware query planner & relational ops --------------------------
  :: Planning (use the index when possible), range-on-an-indexed-field, compound
  :: predicates, and joins, layered over the scan/filter/aggregate operators above.

  :: EQUALITY on `field`: probe a secondary index when one exists on `field` (the primary
  :: or any added with db_addindex), else fall back to a scan + filter — the db picks the plan.
  db_select = fn [d field value lo hi] ->
    if (db_imaphas (db_index d) field)
      then (db_queryon d field value)
      else (db_where (fn [e] -> ((db_fieldof e field) == value)) (db_scan d lo hi))
  :: RANGE on an indexed `field`, via that field's sorted index (cord collation); the
  :: primary-field form keeps the old name. Numeric fields use db_between (see below).
  db_idxrangeon = fn [d field lo hi] ->
    (foldl (fn [acc fe] -> (append acc (db_queryon d field (head fe)))) 0 (lsm_range (db_imapget (db_index d) field) lo hi))
  db_idxrange = fn [d lo hi] -> (db_idxrangeon d (db_idxtag d) lo hi)
  :: add a secondary index on `field`, backfilling it from the rows already stored, so
  :: queries on `field` become index-probes instead of scans. Idempotent.
  db_addindex = fn [d field] ->
    if (db_imaphas (db_index d) field) then d
    else
      let imap0 = (append (db_index d) [ [ field (lsm_new 256) ] 0 ]),
          live  = (lsm_live (db_store d)) in
      let imap1 = (foldl (fn [m e] ->
            let pk = (head e), rec = (chain_at (db_chain d pk) (db_ts d)) in
            (db_reindex1 m field pk %none rec)) imap0 live) in
      (db_make (db_store d) imap1 (db_bloom d) (db_idxtag d) (db_rschema d) (db_ts d) (db_wal d))
  :: which fields currently have a secondary index
  db_indexes = fn [d] -> (db_imapfields (db_index d))
  :: NUMERIC range filter on field `f`, keeping entries with lo <= value <= hi. Composes
  :: after a scan (e.g. db_scan); not index-accelerated, because the index collation is
  :: byte-wise, not numeric — the honest cost of ranging a field the index doesn't order.
  db_between = fn [f lo hi es] ->
    (db_where (fn [e] -> let v = (db_fieldof e f) in
       (if (lt v lo) then 1 else (if (lt hi v) then 1 else 0))) es)

  :: primary key of an entry
  db_pk = fn [e] -> (head e)
  :: AND / OR of two result sets, by primary key (compose predicates)
  db_and = fn [xs ys] -> let yk = (map (fn [e] -> (db_pk e)) ys) in
    (filter (fn [e] -> (member (db_pk e) yk)) xs)
  db_or  = fn [xs ys] -> let xk = (map (fn [e] -> (db_pk e)) xs) in
    (append xs (filter (fn [e] -> if ((member (db_pk e) xk) == 0) then 1 else 0) ys))
  :: equi-JOIN of two result sets: every (x,y) with x.fx == y.fy, emitted as [x y]
  db_join = fn [xs fx ys fy] ->
    (foldl (fn [acc x] ->
       (append acc (map (fn [y] -> [ x y ])
                        (filter (fn [y] -> ((db_fieldof y fy) == (db_fieldof x fx))) ys))))
     0 xs)

  :: a numeric fixture for analytics demos: four orders, region in field 1 (the
  :: indexed field — a cord, so the index's range scan is in the right order) and
  :: amount in field 2 (numeric, ranged with db_between since the index is cord-ordered).
  db_orders = fn [_] ->
    (db_put (db_put (db_put (db_put (db_open 1 0 8)
       %o1 [ [1 %west] [ [2 100] 0 ] ])
       %o2 [ [1 %east] [ [2 250] 0 ] ])
       %o3 [ [1 %west] [ [2 150] 0 ] ])
       %o4 [ [1 %east] [ [2 300] 0 ] ])

  :: ---- transactions and isolation levels (Ch.7) ---------------------------
  :: A transaction reads at a SNAPSHOT (a timestamp) and, at commit, the database
  :: decides whether letting it through would break isolation. Because a db value is
  :: immutable, "begin" is free: just remember the current timestamp.
  db_begin = fn [d] -> (db_ts d)
  :: Reads go through the snapshot, so the transaction sees one consistent instant
  :: no matter how many newer versions other writers have appended since.
  db_txget = fn [d snap pk] -> (db_getat d pk snap)

  :: -- level 1: SNAPSHOT ISOLATION (what Postgres/Oracle/MySQL call it) ---------
  :: SI aborts only on a write-WRITE conflict: a key THIS transaction writes was
  :: written by someone else since our snapshot ("first committer wins"). It blocks
  :: lost updates and dirty/non-repeatable reads, but it does NOT look at the read
  :: set — so it cannot see that two transactions writing DIFFERENT keys based on
  :: OVERLAPPING reads have broken an invariant. That gap is the WRITE SKEW anomaly.
  db_wwconflict = fn [d snap writeset] -> (any (fn [w] -> (gt (db_keyts d (head w)) snap)) writeset)
  db_commit_si = fn [d snap writeset] ->
    if ((db_wwconflict d snap writeset) == 0) then [ %abort d ]
    else [ %commit (foldl (fn [dd w] -> (db_put dd (head w) (tail w))) d writeset) ]

  :: -- level 2: SERIALIZABLE via OPTIMISTIC CONCURRENCY CONTROL ----------------
  :: OCC re-validates the whole READ SET at commit: if any key the transaction read
  :: has a committed version newer than its snapshot, someone changed the world it
  :: reasoned about, so abort. Re-checking reads (not just writes) is exactly what
  :: closes write skew, giving serializable execution. This is the read-set-
  :: validation route to serializability; it is simpler and more conservative than
  :: true SSI (Cahill et al. 2008, used by Postgres SERIALIZABLE), which tracks
  :: read-write dependency edges and aborts only on a genuinely dangerous cycle, so
  :: SSI permits more concurrency (fewer false aborts) for the same guarantee.
  db_validate = fn [d snap readset] -> (any (fn [pk] -> (gt (db_keyts d pk) snap)) readset)
  db_commit = fn [d snap readset writeset] ->
    if ((db_validate d snap readset) == 0) then [ %abort d ]
    else [ %commit (foldl (fn [dd w] -> (db_put dd (head w) (tail w))) d writeset) ]

  :: -- the canonical write-skew demo: two doctors, both on call (DDIA Ch.7) -----
  :: Invariant: at least one of k1,k2 stays "on". Two transactions take the same
  :: snapshot, each sees the OTHER still on, and each takes ITSELF off. Their writes
  :: touch different keys, so SI lets both through (0 on call — the anomaly), while
  :: serializable OCC aborts the second because a key it READ (the other doctor)
  :: changed under it. The two arms below return the SECOND transaction's outcome.
  db_oncall = fn [_] -> (db_put (db_put (db_open 1 0 256) %k1 [ [1 1] 0 ]) %k2 [ [1 1] 0 ])
  db_skew_si = fn [_] ->
    let d = (db_oncall 0), snap = (db_ts (db_oncall 0)) in
    let r1 = (db_commit_si d snap [ [ %k1 [ [1 0] 0 ] ] 0 ]) in
    (head (db_commit_si (tail r1) snap [ [ %k2 [ [1 0] 0 ] ] 0 ]))
  db_skew_ser = fn [_] ->
    let d = (db_oncall 0), snap = (db_ts (db_oncall 0)) in
    let r1 = (db_commit d snap [ %k1 [ %k2 0 ] ] [ [ %k1 [ [1 0] 0 ] ] 0 ]) in
    (head (db_commit (tail r1) snap [ %k1 [ %k2 0 ] ] [ [ %k2 [ [1 0] 0 ] ] 0 ]))

  :: ---- partitioning (Ch.6) -------------------------------------------------
  :: route a key to its shard on a consistent-hash ring. A LOCAL (document-
  :: partitioned) secondary index lives on each shard and a query by field must
  :: scatter/gather across all shards; a GLOBAL (term-partitioned) index is itself
  :: partitioned by field value, so a field query routes to one shard but a write
  :: must update a remote index partition. `db_idx*` here is a local index; routing
  :: shows where a global index partition would live.
  db_route = fn [ring pk ringsize] -> (ch_lookup ring pk ringsize)

  :: ===========================================================================
  :: LEADERLESS REPLICATION (Ch.5): N replicas, quorum W/R, version-vector siblings
  :: ---------------------------------------------------------------------------
  :: A replica is an assoc map pk -> MV-Register (a CRDT set of causally-maximal
  :: [value vclock] entries). A cluster is [ replicas [ n [ w r ] ] ].
  clu_pack = fn [reps n w r] -> [ reps [ n [ w [ r 0 ] ] ] ]
  clu_make = fn [n w r] -> (clu_pack 0 n w r)
  clu_reps = fn [c] -> (nth c 0)
  clu_n    = fn [c] -> (nth c 1)
  clu_w    = fn [c] -> (nth c 2)
  clu_r    = fn [c] -> (nth c 3)
  :: does this config guarantee a read sees the latest write? 0 = yes (W+R>N).
  clu_strong = fn [c] -> (q_overlap (clu_n c) (clu_w c) (clu_r c))

  :: the register for `pk` on one replica (empty if absent)
  clu_repof = fn [reps i] -> (aget reps i 0)
  clu_regof = fn [rep pk] -> (aget rep pk (mv_new 0))
  :: merge the registers for `pk` across a set of replicas (indices `idxs`)
  clu_merge = fn [reps idxs pk] ->
    (foldl (fn [acc i] -> (mv_merge acc (clu_regof (clu_repof reps i) pk))) (mv_new 0) idxs)
  :: index lists for the write quorum (first W) and the read quorum (last R) — they
  :: overlap exactly when W + R > N, which is what makes a quorum read consistent.
  clu_wset = fn [c] -> (range (clu_w c))
  clu_rset = fn [c] -> (map (fn [i] -> (add i (sub (clu_n c) (clu_r c)))) (range (clu_r c)))

  :: write [val vc] into the registers of the replicas in `idxs`
  clu_spread = fn [reps idxs pk val vc] ->
    (foldl (fn [rs i] -> (aput rs i (aput (clu_repof rs i) pk (mv_set (clu_regof (clu_repof rs i) pk) val vc))))
           reps idxs)

  :: a coordinated, causally-aware write at node `node`: read the current merged vclock
  :: across the write quorum, advance the writer's own counter, and store it on W
  :: replicas. Because it descends from what it saw, it SUPERSEDES prior versions.
  clu_put = fn [c pk val node] ->
    let reps = (clu_reps c),
        seen = (clu_merge reps (clu_wset c) pk),
        base = (foldl (fn [acc e] -> (vc_merge acc (tail e))) (vc_new 0) seen),
        vc = (vc_inc base node),
        reps2 = (clu_spread reps (clu_wset c) pk val vc) in
    (clu_pack reps2 (clu_n c) (clu_w c) (clu_r c))
  :: a BLIND write (no read first), e.g. an offline client: stamps a fresh vclock at
  :: `node`. Two blind writes from different nodes are concurrent -> siblings.
  clu_putblind = fn [c pk val node] ->
    let reps2 = (clu_spread (clu_reps c) (clu_wset c) pk val (vc_inc (vc_new 0) node)) in
    (clu_pack reps2 (clu_n c) (clu_w c) (clu_r c))

  :: a quorum READ: merge the read set's registers. One causally-dominant version ->
  :: [%val v]; several concurrent versions -> [%siblings [..]]; nothing -> %absent.
  clu_get = fn [c pk] ->
    let reg = (clu_merge (clu_reps c) (clu_rset c) pk) in
    if (reg == 0) then %absent
    else if ((mv_conflict reg) == 0) then [ %siblings (mv_values reg) ]
    else [ %val (head (mv_values reg)) ]
  :: READ REPAIR: write the merged register back across the read set, healing
  :: replicas that were stale or missing (anti-entropy on the read path).
  clu_repair = fn [c pk] ->
    let reg = (clu_merge (clu_reps c) (clu_rset c) pk),
        reps2 = (foldl (fn [rs i] -> (aput rs i (aput (clu_repof rs i) pk reg))) (clu_reps c) (clu_rset c)) in
    (clu_pack reps2 (clu_n c) (clu_w c) (clu_r c))

  :: ===========================================================================
  :: ATOMIC COMMIT across shards (Ch.9): two-phase commit, the safety core
  :: ---------------------------------------------------------------------------
  :: Each participant votes by running `prepfn` (-> %yes or %no). The coordinator
  :: commits iff EVERY vote is yes; one no aborts the whole transaction. This is the
  :: atomicity guarantee (uniform decision); like the raft module it is the protocol
  :: skeleton, without the networking, timeouts, or coordinator-recovery log.
  tpc_votes  = fn [nodes prepfn] -> (map prepfn nodes)
  tpc_decide = fn [votes] -> if (all (fn [v] -> (v == %yes)) votes) then %commit else %abort
  tpc_run    = fn [nodes prepfn] -> let votes = (tpc_votes nodes prepfn) in [ (tpc_decide votes) votes ]

  :: ---- ready-made fixtures so every example runs as a one-liner -------------
  :: a database indexed on field 2 (a "city"); three users, two in nyc.
  db_sample = fn [_] ->
    (db_put (db_put (db_put (db_open 2 0 4) %u1 [ [1 %alice] [ [2 %nyc] 0 ] ])
                    %u2 [ [1 %bob] [ [2 %sfo] 0 ] ])
            %u3 [ [1 %carol] [ [2 %nyc] 0 ] ])
  :: a 3-replica cluster with W=R=2 (so W+R>N: a quorum read sees the latest write).
  clu_sample = fn [_] -> (clu_make 3 2 2)

  :: =========================================================================
  :: TEXT-FRAME FRONT END — arms returning [%html cord] embed as a live object
  :: wherever their command runs.  Drive them from Db.Tool: edit the key / name /
  :: city / query fields and click, or edit these arms and Compile.  A range or
  :: query entry is [pk [%rec fields]]; `db_rec` unwraps it to the raw fields.
  :: -------------------------------------------------------------------------
  db_rec = fn [e] -> (tail (tail e))
  db_trow = fn [d e] ->
    let pk = (head e), f = (db_rec e) in
    (catall [ "<tr><td><code>" pk "</code></td><td>" (db_field f 1) "</td><td>" (db_field f 2)
              "</td><td align=right>" (numtext (len (db_history d pk))) "</td></tr>" 0 ])
  db_rows = fn [d es] -> (catall (map (fn [e] -> (db_trow d e)) es))
  :: the state dashboard: every key in [lo,hi] with its visible record and version count
  db_dash = fn [d lo hi] ->
    [ %html (catall [
        "<div style=\"font:13px/1.5 system-ui,sans-serif\"><h3 style=\"margin:.1em 0\">Database</h3>"
        "<p style=\"color:#8a8676;margin:.2em 0\">LSM &middot; write-ahead log &middot; Bloom filter &middot; secondary index &middot; MVCC versions</p>"
        "<table class=\"m\"><tr><th align=left>key</th><th align=left>name</th><th align=left>city</th><th>versions</th></tr>"
        (db_rows d (db_range d lo hi))
        "</table><p style=\"color:#8a8676\">write-ahead log entries: " (numtext (len (db_wal d))) "</p></div>" 0 ]) ]
  db_dash0 = fn [_] -> (db_dash (db_sample 0) %u0 %u9)
  :: a dashboard over an EXPLICIT key list (not a key range) — the host passes the
  :: keys it knows are live, so a persistent database with arbitrary keys renders
  :: without depending on cord ordering. Same row shape as db_dash.
  db_entryk = fn [d k] -> [ k (db_get d k) ]
  db_dashkeys = fn [d ks] ->
    [ %html (catbal [
        "<div style=\"font:13px/1.5 system-ui,sans-serif\"><h3 style=\"margin:.1em 0\">Database (persistent)</h3>"
        "<p style=\"color:#8a8676;margin:.2em 0\">on-disk write-ahead log &middot; LSM &middot; Bloom filter &middot; secondary index &middot; MVCC versions</p>"
        "<table class=\"m\"><tr><th align=left>key</th><th align=left>name</th><th align=left>city</th><th>versions</th></tr>"
        (db_rows d (map (fn [k] -> (db_entryk d k)) ks))
        "</table><p style=\"color:#8a8676\">write-ahead log entries: " (numtext (len (db_wal d))) "</p></div>" 0 ]) ]

  :: a secondary-index query rendered as a list — every live row whose city = fv
  db_queryli = fn [e] ->
    (catall [ "<li><code>" (head e) "</code> &mdash; " (db_field (db_rec e) 1) " (" (db_field (db_rec e) 2) ")</li>" 0 ])
  db_queryhtml = fn [d fv] ->
    [ %html (catall [
        "<div style=\"font:13px/1.5 system-ui,sans-serif\"><b>secondary-index query &middot; city = " fv "</b><ul style=\"margin:.3em 0\">"
        (catall (map (fn [e] -> (db_queryli e)) (db_query d fv)))
        "</ul></div>" 0 ]) ]

  :: the MVCC version history of one key, newest first (time-travel made visible)
  db_verli = fn [ver] ->
    let ts = (head ver), f = (tail ver) in
    (catall [ "<li>ts " (numtext ts) ": "
              (if (f == %tomb) then "(deleted)" else (catall [ (db_field f 1) " / " (db_field f 2) 0 ]))
              "</li>" 0 ])
  db_historyhtml = fn [d pk] ->
    [ %html (catall [
        "<div style=\"font:13px/1.5 system-ui,sans-serif\"><b>version history of <code>" pk "</code></b> (MVCC, newest first)<ol style=\"margin:.3em 0\">"
        (catall (map (fn [ver] -> (db_verli ver)) (db_history d pk)))
        "</ol></div>" 0 ]) ]
end
