:: ===========================================================================
:: dist.lat — distributed execution across connected Orpheus instances.
::
:: The PURE side of the distribution layer. Every arm here is an ordinary
:: Latte function with a deterministic meaning on Loom; the Rust host
:: (src/dist.rs) uses them as the *specification* of what distribution must
:: compute, in the same spirit as jets: remote execution is an accelerated,
:: audited implementation of a pure definition, never a change of meaning.
::
::   dmap     — the distributable map. Its meaning IS (map f xs). When this
::              instance is connected to workers (`latte worker`, `latte
::              workers add`), the host splits xs into chunks, evaluates
::              (map f chunk) on the workers in parallel, and concatenates —
::              a result the interpreter would have produced, faster.
::   shard    — round-robin split of a list into k shards (the data-parallel
::              decomposition used for distributed model training).
::   unshard  — inverse of shard: interleave the shards back into one list.
::   wmean    — weighted mean of signed numbers (weights are naturals).
::   fedavg   — FedAvg consolidation (McMahan et al. 2017): combine locally
::              trained [w b] models into one, each weighted by the size of
::              the shard it was trained on:  w = Σ (n_k / n) · w_k.
::
:: Distributed training is cycles of the two halves: shard the data, train a
:: local model per shard on each machine (lib/ml.lat `train`), consolidate
:: with fedavg, repeat — and only the final consolidated model becomes an
:: event in the persistent log.   Arms prefixed with no letter (dmap) or
:: dist_ helpers.
:: ===========================================================================
import num
core dist
  :: the distributable map — semantics identical to map (the host accelerates it)
  dmap = fn [f xs] -> (map f xs)

  :: every k-th element of xs starting at offset i (helper for shard)
  dist_nth = fn [k i xs] ->
    loop with [c = xs, j = 0, acc = 0] :
      if (c == 0) then (reverse acc)
      else if ((mod j k) == i) then again((tail c), +(j), [ (head c) acc ])
      else again((tail c), +(j), acc)
    end

  :: round-robin split into k shards: (shard 2 [1 [2 [3 [4 0]]]]) = [ [1 [3 0]] [ [2 [4 0]] 0 ] ]
  shard = fn [k xs] ->
    loop with [i = 0, acc = 0] :
      if (i == k) then (reverse acc)
      else again(+(i), [ (dist_nth k i xs) acc ])
    end

  :: are all shards empty? (0 = yes, 1 = no — the loobean convention)
  dist_allempty = fn [ss] ->
    loop with [c = ss] :
      if (c == 0) then 0
      else if ((head c) == 0) then again((tail c))
      else 1
    end

  :: the heads of every non-empty shard, in shard order
  dist_heads = fn [ss] ->
    loop with [c = ss, acc = 0] :
      if (c == 0) then (reverse acc)
      else if ((head c) == 0) then again((tail c), acc)
      else again((tail c), [ (head (head c)) acc ])
    end

  :: every shard advanced one step (empty shards stay empty)
  dist_tails = fn [ss] ->
    loop with [c = ss, acc = 0] :
      if (c == 0) then (reverse acc)
      else if ((head c) == 0) then again((tail c), [ 0 acc ])
      else again((tail c), [ (tail (head c)) acc ])
    end

  :: inverse of shard: interleave the shards back into one list
  unshard = fn [ss] ->
    loop with [cur = ss, acc = 0] :
      if (dist_allempty cur) then (concat (reverse acc))
      else again((dist_tails cur), [ (dist_heads cur) acc ])
    end

  :: sizes of a list of shards (the FedAvg weights)
  sizes = fn [ss] -> (map (fn [s] -> (len s)) ss)

  :: weighted mean of signed numbers vs, weighted by naturals ws (Σws > 0):
  :: Σ (w_k · v_k) / Σ w_k  — the consolidation kernel of FedAvg
  wmean = fn [vs ws] ->
    let tot = (npos (mul (sum ws) 1000)) in
    let s = loop with [pv = vs, pw = ws, acc = [0 0]] :
              if (pv == 0) then acc
              else again((tail pv), (tail pw),
                         (nadd acc (nmul (head pv) (npos (mul (head pw) 1000)))))
            end in
    (ndiv s tot)

  :: FedAvg consolidation of linear models: models is a list of [w b] cells
  :: (signed numbers), ws the shard sizes. Returns the consolidated [w b].
  fedavg = fn [models ws] ->
    [ (wmean (map (fn [m] -> (head m)) models) ws)
      (wmean (map (fn [m] -> (tail m)) models) ws) ]
end
