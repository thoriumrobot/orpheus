:: ===========================================================================
:: crdt.lat — Conflict-free Replicated Data Types (DDIA, Ch. 5, p. 174).
::
:: CRDTs converge without coordination: their MERGE is commutative, associative,
:: and idempotent (a join on a lattice), so replicas that see the same set of
:: updates in any order reach the same state — strong eventual consistency. This
:: is exactly the convergence Orpheus's own gossip layer relies on.
:: Classics:  G-Counter, PN-Counter, G-Set, LWW-Register — plus the causal ones
:: that actually handle concurrent add/remove and concurrent writes correctly:
:: an OBSERVED-REMOVE SET and a MULTI-VALUE REGISTER (the Dynamo "siblings" model).
:: Arms prefixed `gc_` / `pn_` / `gs_` / `lww_` / `or_` / `mv_`.
:: ===========================================================================
import std
import vclock
core crdt
  :: ---- G-Counter: grow-only counter, per-node sub-counts -------------------
  :: state = list of [node count]; merge = pointwise max; value = sum
  gc_new   = fn [_] -> 0
  gc_get   = fn [g node] ->
    loop with [c = g] :
      if (c == 0) then 0
      else if ((head (head c)) == node) then (tail (head c))
      else again((tail c))
    end
  gc_inc   = fn [g node d] ->
    [ [node (add (gc_get g node) d)] (filter (fn [e] -> (not ((head e) == node))) g) ]
  :: the union of the node ids appearing in either counter (a's order, then b's novelties)
  gc_nodes = fn [a b] ->
    let na = (map (fn [e] -> (head e)) a) in
    (append na (filter (fn [nd] -> (not (member nd na))) (map (fn [e] -> (head e)) b)))
  :: JOIN = per-node MAX. Each node only ever increments its OWN slot, so the
  :: larger of two observations is always the newer one — max is commutative,
  :: associative, and idempotent, which is exactly what makes merge conflict-free.
  gc_merge = fn [a b] ->
    (map (fn [nd] -> [ nd (max (gc_get a nd) (gc_get b nd)) ]) (gc_nodes a b))
  gc_value = fn [g] -> (foldl (fn [s e] -> (add s (tail e))) 0 g)

  :: ---- PN-Counter: two G-Counters [P N]; value = sum(P) - sum(N) -----------
  pn_new   = fn [_] -> [ 0 0 ]
  pn_inc   = fn [p node d] -> [ (gc_inc (head p) node d) (tail p) ]
  pn_dec   = fn [p node d] -> [ (head p) (gc_inc (tail p) node d) ]
  pn_merge = fn [a b] -> [ (gc_merge (head a) (head b)) (gc_merge (tail a) (tail b)) ]
  pn_value = fn [p] -> (sub (gc_value (head p)) (gc_value (tail p)))

  :: ---- G-Set: grow-only set; merge = union --------------------------------
  gs_new   = fn [_] -> 0
  gs_add   = fn [s x] -> if ((member x s) == 0) then s else [ x s ]
  gs_has   = fn [s x] -> (member x s)
  gs_merge = fn [a b] -> (foldl (fn [s x] -> (gs_add s x)) a b)

  :: ---- LWW-Register: [ts value node]; higher ts wins (tie: higher node) ----
  lww_new   = fn [_] -> [ 0 [ %nil 0 ] ]
  lww_set   = fn [ts val node] -> [ ts [ val node ] ]
  lww_ts    = fn [r] -> (head r)
  lww_value = fn [r] -> (head (tail r))
  lww_node  = fn [r] -> (tail (tail r))
  lww_merge = fn [a b] ->
    if (gt (lww_ts a) (lww_ts b)) then a
    else if (gt (lww_ts b) (lww_ts a)) then b
    else if (gte (lww_node a) (lww_node b)) then a
    else b

  :: ---- OR-Set: observed-remove set (concurrent add/remove done right) -------
  :: Each add stamps the element with a UNIQUE tag (a dot, e.g. [node seq]); a
  :: remove tombstones exactly the tags it has OBSERVED. An element is present if
  :: some add-tag survives. So a concurrent add wins over a remove that never saw
  :: it — the behaviour a naive 2P-set gets wrong. state = [adds removes], each a
  :: set of [elem tag] pairs.
  or_ins     = fn [s x] -> if ((member x s) == 0) then s else [ x s ]
  or_union   = fn [a b] -> (foldl (fn [s x] -> (or_ins s x)) a b)
  or_new     = fn [_] -> [ 0 0 ]
  or_adds    = fn [s] -> (head s)
  or_removes = fn [s] -> (tail s)
  or_add     = fn [s e tag] -> [ (or_ins (or_adds s) [e tag]) (or_removes s) ]
  :: remove observes (tombstones) every add-tag currently seen for e
  or_remove  = fn [s e] ->
    [ (or_adds s)
      (foldl (fn [rs p] -> (or_ins rs p)) (or_removes s)
             (filter (fn [p] -> ((head p) == e)) (or_adds s))) ]
  :: present iff some [e tag] in adds is not in removes
  or_has = fn [s e] ->
    (any (fn [p] -> (and ((head p) == e) (not (member p (or_removes s))))) (or_adds s))
  or_merge = fn [a b] ->
    [ (or_union (or_adds a) (or_adds b)) (or_union (or_removes a) (or_removes b)) ]
  :: distinct elements currently present
  or_elems = fn [s] ->
    (foldl (fn [acc p] ->
              if (and (not (member p (or_removes s))) (not (member (head p) acc)))
              then [ (head p) acc ] else acc)
           0 (or_adds s))

  :: ---- MV-Register: keeps all CONCURRENT values (Dynamo siblings) -----------
  :: state = set of [value vclock]. A write supersedes every value whose clock it
  :: dominates; merge keeps the causally-maximal values, so concurrent writes BOTH
  :: survive for the application to resolve (rather than one silently winning).
  mv_new    = fn [_] -> 0
  mv_set    = fn [reg val vc] ->
    [ [val vc] (filter (fn [e] -> (not ((vc_le (tail e) vc) == 0))) reg) ]
  mv_maximal = fn [e u] ->
    (all (fn [f] -> (not ((vc_compare (tail e) (tail f)) == %before))) u)
  :: merge two registers: keep the causally-maximal values, and (since a register is
  :: a SET) collapse entries that are exactly equal — e.g. the same version arriving
  :: from two replicas during read repair. Genuinely concurrent values, differing in
  :: payload or clock, both survive as siblings.
  mv_merge  = fn [a b] -> let u = (append a b) in (nub (filter (fn [e] -> (mv_maximal e u)) u))
  mv_values = fn [reg] -> (map (fn [e] -> (head e)) reg)
  mv_conflict = fn [reg] -> (gt (len reg) 1)        :: 0 = siblings present
end
