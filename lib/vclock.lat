:: ===========================================================================
:: vclock.lat — vector clocks / version vectors (DDIA, Ch. 5, pp. 184-191).
::
:: A version vector maps each node to a counter. Comparing two vectors tells you
:: their causal relationship: one happened-before the other, they are equal, or
:: they are CONCURRENT (a write conflict that needs resolution — siblings, in
:: Dynamo terms). This is how leaderless/multi-leader stores detect conflicts
:: instead of silently losing writes.   Arms prefixed `vc_`.
::
:: vclock = list of [node counter] pairs (a node absent counts as 0).
:: ===========================================================================
import std
core vclock
  vc_new = fn [_] -> 0
  vc_get = fn [vc node] ->
    loop with [c = vc] :
      if (c == 0) then 0
      else if ((head (head c)) == node) then (tail (head c))
      else again((tail c))
    end
  :: set node's counter (replace or insert)
  vc_set = fn [vc node n] -> [ [node n] (filter (fn [e] -> (not ((head e) == node))) vc) ]
  :: a local event on `node`: bump its counter
  vc_inc = fn [vc node] -> (vc_set vc node +((vc_get vc node)))

  :: the set of node ids appearing in either vector
  vc_nodes = fn [a b] ->
    let na = (map (fn [e] -> (head e)) a) in
    (append na (filter (fn [nd] -> (not (member nd na))) (map (fn [e] -> (head e)) b)))

  :: pointwise maximum — the merge that a replica does on receiving an update
  vc_merge = fn [a b] ->
    (map (fn [nd] -> [ nd (max (vc_get a nd) (vc_get b nd)) ]) (vc_nodes a b))

  :: a <= b  (every component of a is <= b's) — loobean 0 = true
  vc_le = fn [a b] -> (all (fn [e] -> (lte (tail e) (vc_get b (head e)))) a)
  vc_eq = fn [a b] -> (and (vc_le a b) (vc_le b a))

  :: the causal relationship as a tag: %eq, %before, %after, or %concurrent
  vc_compare = fn [a b] ->
    let ab = (vc_le a b) in
    let ba = (vc_le b a) in
    if ((and ab ba) == 0) then %eq
    else if (ab == 0) then %before
    else if (ba == 0) then %after
    else %concurrent

  :: a write conflict is two CONCURRENT vectors
  vc_conflict = fn [a b] -> if ((vc_compare a b) == %concurrent) then 0 else 1
end
