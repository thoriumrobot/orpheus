:: ===========================================================================
:: scatok.lat — the SCArs grapheme TOKENIZER, written in Latte (runs on Loom).
::
:: This migrates the word-splitting stage of the sound-change engine out of the
:: Rust host (src/sca.rs::tokenize) and into Latte.  Tokenization is longest-
:: match over a phoneme inventory: a writing system may spell one phoneme with a
:: multi-letter grapheme (a digraph like "th" or "kʷ"), so at each position we
:: greedily match the LONGEST inventory grapheme, and otherwise consume exactly
:: one Unicode codepoint.
::
:: Latte cords are packed UTF-8 bytes; `bytes` gives the byte list and
:: `frombytes` repacks one.  We therefore tokenize at the byte level but step by
:: whole codepoints, so multibyte letters (ā, ñ, ̃) are never split.
:: ===========================================================================
import std
core scatok
  :: ---- UTF-8 helpers -------------------------------------------------------
  :: number of bytes in the codepoint whose lead byte is b
  u8len = fn [b] ->
    if (lt b 128) then 1 else if (lt b 224) then 2 else if (lt b 240) then 3 else 4
  :: number of CODEPOINTS in a byte list (count non-continuation bytes:
  :: a continuation byte is in 128..191, i.e. >=128 and <192)
  cplen = fn [bs] ->
    loop with [c = bs, n = 0] :
      if (c == 0) then n
      else let b = (head c) in
        again((tail c), (if (lt b 128) then (+(n)) else if (gte b 192) then (+(n)) else n))
    end

  :: ---- longest-match machinery --------------------------------------------
  :: does the byte list `gb` occur as a prefix of `bs`?  0 = yes, 1 = no.
  bprefix = fn [gb bs] ->
    loop with [g = gb, s = bs] :
      if (g == 0) then 0
      else if (s == 0) then 1
      else if ((head g) == (head s)) then again((tail g), (tail s))
      else 1
    end

  :: insert a byte list into a list-of-byte-lists kept in DESCending length
  :: order (so longest graphemes are tried first)
  ins = fn [x ys] ->
    if (ys == 0) then [ x 0 ]
    else if (gte (len x) (len (head ys))) then [ x ys ]
    else [ (head ys) (ins x (tail ys)) ]
  sortdesc = fn [xs] -> (foldl (fn [s x] -> (ins x s)) 0 xs)

  :: the longest inventory grapheme matching the head of `bs`, or 0
  glong = fn [gbs bs] ->
    loop with [gs = gbs] :
      if (gs == 0) then 0
      else if ((bprefix (head gs) bs) == 0) then (head gs)
      else again((tail gs))
    end

  :: tokenize a byte list into a list of grapheme cords
  tokbytes = fn [gbs bs] ->
    loop with [s = bs, out = 0] :
      if (s == 0) then (reverse out)
      else let g = (glong gbs s) in
        if (g == 0)
          then let n = (u8len (head s)) in
               again((drop n s), [ (frombytes (take n s)) out ])
          else again((drop (len g) s), [ (frombytes g) out ])
    end

  :: ---- the public entry point ---------------------------------------------
  :: `tokenize graphemes word` : `graphemes` is the phoneme inventory (a list of
  :: cords) and `word` is a cord; result is the list of grapheme cords.  Only
  :: MULTI-codepoint graphemes need longest-match; single letters fall through to
  :: the one-codepoint step, so the inventory only contributes its digraphs.
  tokenize = fn [graphemes word] ->
    let gbs = (sortdesc
                (filter (fn [g] -> if (gt (cplen g) 1) then 0 else 1)
                        (map (fn [g] -> (bytes g)) graphemes))) in
    (tokbytes gbs (bytes word))
end
