:: ===========================================================================
:: xiangqi.lat — Chinese chess for the Orpheus boardgame tool, in Latte.
::
:: Board: a 0-terminated list of 90 squares, index = row*9 + col; row 0 is
:: Black's back rank (top), row 9 White's. The RIVER lies between rows 4 and 5;
:: each PALACE is the 3×3 of cols 3-5 in rows 0-2 (Black) and 7-9 (White).
:: Pieces: 0 empty; White 1=Soldier 2=Horse 3=Elephant 4=Chariot 5=Cannon
:: 6=Advisor 7=General; Black 8-14 in the same order. White moves toward row 0.
:: State: [board side 0], side 1 = White (Red) to move, 2 = Black.
:: Move:  [from to 0].
::
:: The real rules, in full: soldiers gain sideways moves after crossing the
:: river; horses are blocked by the adjacent "leg"; elephants jump two
:: diagonally, are blocked by the "eye", and may not cross the river; cannons
:: move like chariots but capture only by jumping exactly one screen piece;
:: advisors and generals are confined to the palace; and the two generals may
:: never face each xqother on an open file (the flying-general rule).
:: ===========================================================================
import std
core xiangqi

  :: ---- square / piece helpers ----
  xqidx     = fn [r c] -> (add (mul r 9) c)
  xqrowof   = fn [i] -> (div i 9)
  xqcolof   = fn [i] -> (mod i 9)
  xqother   = fn [side] -> if (side == 1) then 2 else 1
  xqcolorof = fn [p] -> if (p == 0) then 0 else if (lt p 8) then 1 else 2
  xqptype   = fn [p] -> if (p == 0) then 0 else if (lt p 8) then p else (sub p 7)

  :: xqtarget square from (r,c) by signed offsets (sr/sc 0=minus 1=plus, mr/mc
  :: magnitudes); 90 = off the board
  xqtarget = fn [r c sr mr sc mc] ->
    let nr = (if (sr == 0) then (if (lt r mr) then 99 else (sub r mr)) else (add r mr)) in
    let nc = (if (sc == 0) then (if (lt c mc) then 99 else (sub c mc)) else (add c mc)) in
    if (or (gt nr 9) (gt nc 8)) then 90 else (xqidx nr nc)

  xqsetnth = fn [xs k v] ->
    loop with [c = xs, i = 0, acc = 0] :
      if (c == 0) then (reverse acc)
      else again((tail c), +(i), [ (if (i == k) then v else (head c)) acc ])
    end

  xqindexof = fn [xs v] ->
    loop with [c = xs, i = 0] :
      if (c == 0) then 90
      else if ((head c) == v) then i else again((tail c), +(i))
    end

  :: a move to t is admissible if on-board and not onto an own piece
  xqokstep = fn [board side t] -> if (t == 90) then 1 else if ((xqcolorof (nth board t)) == side) then 1 else 0

  :: in the palace of `side`? (cols 3-5; rows 7-9 for White, 0-2 for Black)
  xqinpalace = fn [side t] ->
    if (t == 90) then 1
    else
      let r = (xqrowof t) in let c = (xqcolof t) in
      if (or (lt c 3) (gt c 5)) then 1
      else if (side == 1) then (if (lt r 7) then 1 else 0)
      else (if (gt r 2) then 1 else 0)

  :: own side of the river? (rows 5-9 for White, 0-4 for Black)
  xqownside = fn [side t] ->
    if (t == 90) then 1
    else if (side == 1) then (if (lt (xqrowof t) 5) then 1 else 0)
    else (if (gt (xqrowof t) 4) then 1 else 0)

  :: ---- chariot: four orthogonal rays --------------------------------------
  xqray = fn [board i sr sc side] ->
    loop with [cur = i, acc = 0] :
      let r = (xqrowof cur) in let c = (xqcolof cur) in
      let t = (xqtarget r c sr 1 sc (if (sr == 2) then 1 else 0)) in
      if (t == 90) then (reverse acc)
      else
        let p = (nth board t) in
        if (p == 0) then again(t, [ t acc ])
        else if ((xqcolorof p) == side) then (reverse acc)
        else (reverse [ t acc ])
    end

  :: directions encoded as (sr mr sc mc) quadruples for the orthogonals:
  :: up (0 1 1 0), down (1 1 1 0) ... simpler: four explicit rays
  xqrayup    = fn [board i side] ->
    loop with [cur = i, acc = 0] :
      let r = (xqrowof cur) in
      if (r == 0) then (reverse acc)
      else let t = (xqidx (sub r 1) (xqcolof cur)) in
        let p = (nth board t) in
        if (p == 0) then again(t, [ t acc ])
        else if ((xqcolorof p) == side) then (reverse acc) else (reverse [ t acc ])
    end
  xqraydown  = fn [board i side] ->
    loop with [cur = i, acc = 0] :
      let r = (xqrowof cur) in
      if (r == 9) then (reverse acc)
      else let t = (xqidx (add r 1) (xqcolof cur)) in
        let p = (nth board t) in
        if (p == 0) then again(t, [ t acc ])
        else if ((xqcolorof p) == side) then (reverse acc) else (reverse [ t acc ])
    end
  xqrayleft  = fn [board i side] ->
    loop with [cur = i, acc = 0] :
      let c = (xqcolof cur) in
      if (c == 0) then (reverse acc)
      else let t = (xqidx (xqrowof cur) (sub c 1)) in
        let p = (nth board t) in
        if (p == 0) then again(t, [ t acc ])
        else if ((xqcolorof p) == side) then (reverse acc) else (reverse [ t acc ])
    end
  xqrayright = fn [board i side] ->
    loop with [cur = i, acc = 0] :
      let c = (xqcolof cur) in
      if (c == 8) then (reverse acc)
      else let t = (xqidx (xqrowof cur) (add c 1)) in
        let p = (nth board t) in
        if (p == 0) then again(t, [ t acc ])
        else if ((xqcolorof p) == side) then (reverse acc) else (reverse [ t acc ])
    end

  xqchariotmoves = fn [board i side] ->
    (append (xqrayup board i side) (append (xqraydown board i side)
      (append (xqrayleft board i side) (xqrayright board i side))))

  :: ---- cannon: slides like a chariot, captures over exactly one screen ----
  xqcannonline = fn [board i dr dc side] ->
    :: dr/dc in {0,1,2}: 0 = -1, 1 = +1, 2 = 0  (one of them is 2)
    loop with [cur = i, jumped = 0, acc = 0] :
      let r = (xqrowof cur) in let c = (xqcolof cur) in
      let nr = (if (dr == 2) then r else (if (dr == 0) then (if (r == 0) then 99 else (sub r 1)) else (add r 1))) in
      let nc = (if (dc == 2) then c else (if (dc == 0) then (if (c == 0) then 99 else (sub c 1)) else (add c 1))) in
      if (or (gt nr 9) (gt nc 8)) then (reverse acc)
      else
        let t = (xqidx nr nc) in
        let p = (nth board t) in
        if (jumped == 0)
          then (if (p == 0) then again(t, 0, [ t acc ]) else again(t, 1, acc))
          else (if (p == 0) then again(t, 1, acc)
                else (if ((xqcolorof p) == side) then (reverse acc) else (reverse [ t acc ])))
    end

  xqcannonmoves = fn [board i side] ->
    (append (xqcannonline board i 0 2 side) (append (xqcannonline board i 1 2 side)
      (append (xqcannonline board i 2 0 side) (xqcannonline board i 2 1 side))))

  :: ---- horse: the L-move, blocked by the adjacent leg ---------------------
  :: lsr/lmr/lsc/lmc give the LEG square's offset, sr/mr/sc/mc the move's
  xqhorse1 = fn [board i side lsr lmr lsc lmc sr mr sc mc] ->
    let r = (xqrowof i) in let c = (xqcolof i) in
    let leg = (xqtarget r c lsr lmr lsc lmc) in
    if (leg == 90) then 0
    else if ((nth board leg) == 0)
      then
        let t = (xqtarget r c sr mr sc mc) in
        if (t == 90) then 0
        else (if ((xqokstep board side t) == 0) then [ t 0 ] else 0)
      else 0

  xqhorsemoves = fn [board i side] ->
    (append (xqhorse1 board i side 0 1 0 0 0 2 0 1) (append (xqhorse1 board i side 0 1 0 0 0 2 1 1)
    (append (xqhorse1 board i side 1 1 0 0 1 2 0 1) (append (xqhorse1 board i side 1 1 0 0 1 2 1 1)
    (append (xqhorse1 board i side 0 0 0 1 0 1 0 2) (append (xqhorse1 board i side 0 0 0 1 1 1 0 2)
    (append (xqhorse1 board i side 0 0 1 1 0 1 1 2) (xqhorse1 board i side 0 0 1 1 1 1 1 2))))))))

  :: ---- elephant: two diagonal, eye clear, own side of the river only ------
  xqeleph1 = fn [board i side sr sc] ->
    let r = (xqrowof i) in let c = (xqcolof i) in
    let eye = (xqtarget r c sr 1 sc 1) in
    let t = (xqtarget r c sr 2 sc 2) in
    if (t == 90) then 0
    else if ((xqownside side t) == 1) then 0
    else if ((nth board eye) == 0)
      then (if ((xqokstep board side t) == 0) then [ t 0 ] else 0)
      else 0

  xqelephmoves = fn [board i side] ->
    (append (xqeleph1 board i side 0 0) (append (xqeleph1 board i side 0 1)
      (append (xqeleph1 board i side 1 0) (xqeleph1 board i side 1 1))))

  :: ---- advisor: one diagonal inside the palace ----------------------------
  xqadv1 = fn [board i side sr sc] ->
    let t = (xqtarget (xqrowof i) (xqcolof i) sr 1 sc 1) in
    if (t == 90) then 0
    else if ((xqinpalace side t) == 1) then 0
    else (if ((xqokstep board side t) == 0) then [ t 0 ] else 0)

  xqadvisormoves = fn [board i side] ->
    (append (xqadv1 board i side 0 0) (append (xqadv1 board i side 0 1)
      (append (xqadv1 board i side 1 0) (xqadv1 board i side 1 1))))

  :: ---- general: one orthogonal inside the palace --------------------------
  xqgen1 = fn [board i side sr mr sc mc] ->
    let t = (xqtarget (xqrowof i) (xqcolof i) sr mr sc mc) in
    if (t == 90) then 0
    else if ((xqinpalace side t) == 1) then 0
    else (if ((xqokstep board side t) == 0) then [ t 0 ] else 0)

  xqgeneralmoves = fn [board i side] ->
    (append (xqgen1 board i side 0 1 0 0) (append (xqgen1 board i side 1 1 0 0)
      (append (xqgen1 board i side 2 0 0 1) (xqgen1 board i side 2 0 1 1))))

  :: ---- soldier: forward; sideways too once across the river ---------------
  xqsoldiermoves = fn [board i side] ->
    let r = (xqrowof i) in let c = (xqcolof i) in
    let fwd = (if (side == 1) then (xqtarget r c 0 1 0 0) else (xqtarget r c 1 1 0 0)) in
    let crossed = (if (side == 1) then (if (lt r 5) then 0 else 1) else (if (gt r 4) then 0 else 1)) in
    let f = (if (fwd == 90) then 0 else (if ((xqokstep board side fwd) == 0) then [ fwd 0 ] else 0)) in
    if (crossed == 1) then f
    else
      let lft = (xqtarget r c 2 0 0 1) in
      let rgt = (xqtarget r c 2 0 1 1) in
      let l = (if (lft == 90) then 0 else (if ((xqokstep board side lft) == 0) then [ lft 0 ] else 0)) in
      let g = (if (rgt == 90) then 0 else (if ((xqokstep board side rgt) == 0) then [ rgt 0 ] else 0)) in
      (append f (append l g))

  :: ---- dispatch ------------------------------------------------------------
  xqgenmoves = fn [board i side] ->
    let t = (xqptype (nth board i)) in
    if (t == 1) then (xqsoldiermoves board i side)
    else if (t == 2) then (xqhorsemoves board i side)
    else if (t == 3) then (xqelephmoves board i side)
    else if (t == 4) then (xqchariotmoves board i side)
    else if (t == 5) then (xqcannonmoves board i side)
    else if (t == 6) then (xqadvisormoves board i side)
    else if (t == 7) then (xqgeneralmoves board i side)
    else 0

  :: every xqpseudo-xqlegal move [from to 0] for `side`
  xqpseudo = fn [board side] ->
    loop with [i = 0, acc = 0] :
      if (i == 90) then acc
      else if ((xqcolorof (nth board i)) == side)
        then again(+(i), (append (map (fn [t] -> [ i [ t 0 ] ]) (xqgenmoves board i side)) acc))
        else again(+(i), acc)
    end

  :: every square attacked by `side` (capture squares of its xqpseudo moves)
  xqattacks = fn [board side] ->
    loop with [i = 0, acc = 0] :
      if (i == 90) then acc
      else if ((xqcolorof (nth board i)) == side)
        then again(+(i), (append (xqgenmoves board i side) acc))
        else again(+(i), acc)
    end

  xqfindgeneral = fn [board side] -> (xqindexof board (if (side == 1) then 7 else 14))

  xqapply = fn [board side m] ->
    let f = (nth m 0) in let t = (nth m 1) in
    let p = (nth board f) in
    [ (xqsetnth (xqsetnth board f 0) t p) (xqother side) 0 ]

  :: the FLYING-GENERAL rule: generals may not face each xqother on an open file
  xqfacing = fn [board] ->
    let wg = (xqfindgeneral board 1) in
    let bg = (xqfindgeneral board 2) in
    if ((xqcolof wg) == (xqcolof bg))
      then
        loop with [r = (add (xqrowof bg) 1)] :
          if (r == (xqrowof wg)) then 0
          else if ((nth board (xqidx r (xqcolof wg))) == 0) then again(+(r))
          else 1
        end
      else 1

  :: `side`'s general is safe: not attacked, and the generals are not xqfacing
  :: loobean: 0 = `side`'s general is SAFE (not attacked, generals not facing)
  xqgeneralsafe = fn [board side] ->
    if ((xqfacing board) == 0) then 1
    else (if ((member (xqfindgeneral board side) (xqattacks board (xqother side))) == 1) then 0 else 1)

  xqlegal = fn [state] ->
    let board = (nth state 0) in let side = (nth state 1) in
    (filter (fn [m] -> (xqgeneralsafe (nth (xqapply board side m) 0) side)) (xqpseudo board side))

  :: loobean: 0 = the side to move IS in check
  xqincheck = fn [state] ->
    let board = (nth state 0) in let side = (nth state 1) in
    if ((xqgeneralsafe board side) == 0) then 0 else 1

  :: 0 ongoing; 1 the side to move has no xqlegal move (in xiangqi BOTH mate and
  :: stalemate lose for the stuck player, so one terminal code suffices)
  xqstatus = fn [state] -> if ((xqlegal state) == 0) then 1 else 0

  :: loobean: 0 = `side` gives check
  xqgives_check = fn [board side] ->
    if ((xqgeneralsafe board (xqother side)) == 0) then 1 else 0

  :: a fast greedy chooser (used as a baseline; the trained model lives in
  :: xiangqiml.lat): prefer the capture of the biggest piece, else first move
  xqpval = fn [t] -> if (t == 1) then 1 else if (t == 2) then 4 else if (t == 3) then 2 else if (t == 4) then 9 else if (t == 5) then 4 else if (t == 6) then 2 else 0
  xqmovescore = fn [board m] -> (xqpval (xqptype (nth board (nth m 1))))
  xqchoose = fn [state] ->
    let ms = (xqlegal state) in
    if (ms == 0) then 0
    else
      let board = (nth state 0) in
      loop with [c = (tail ms), best = (head ms), bestv = (xqmovescore board (head ms))] :
        if (c == 0) then best
        else
          let v = (xqmovescore board (head c)) in
          if (lt bestv v) then again((tail c), (head c), v) else again((tail c), best, bestv)
      end

  :: the opening position, built programmatically (xqplacements fold over xqsetnth)
  xqemptyboard = fn [_] ->
    loop with [i = 90, acc = 0] :
      if (i == 0) then acc else again((dec i), [ 0 acc ])
    end

  :: flat [square piece square piece … 0] list of the opening xqplacements
  xqplacements = fn [_] ->
    [ 0 [ 11 [ 1 [ 9 [ 2 [ 10 [ 3 [ 13 [ 4 [ 14 [ 5 [ 13 [ 6 [ 10 [ 7 [ 9 [ 8 [ 11 [ 19 [ 12 [ 25 [ 12 [ 27 [ 8 [ 29 [ 8 [ 31 [ 8 [ 33 [ 8 [ 35 [ 8 [ 54 [ 1 [ 56 [ 1 [ 58 [ 1 [ 60 [ 1 [ 62 [ 1 [ 64 [ 5 [ 70 [ 5 [ 81 [ 4 [ 82 [ 2 [ 83 [ 3 [ 84 [ 6 [ 85 [ 7 [ 86 [ 6 [ 87 [ 3 [ 88 [ 2 [ 89 [ 4 0 ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ] ]

  xqplace2 = fn [board ps] ->
    loop with [b = board, c = ps] :
      if (c == 0) then b
      else again((xqsetnth b (head c) (head (tail c))), (tail (tail c)))
    end

  xqinitial = fn [_] ->
    [ (xqplace2 (xqemptyboard 0) (xqplacements 0)) 1 0 ]
end
