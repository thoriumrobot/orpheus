:: ===========================================================================
:: tool.lat — a library of system *commands*, written in Latte itself.
::
:: In the Oberon-style GUI a command is `Module.arm args`: the environment calls
:: arm `args` of a loaded module and shows the result in the Log. The commands
:: here are ordinary Latte arms — so the command set of the system is itself
:: Latte source you can edit, recompile and run from the GUI, no Rust rebuild.
:: Each arm takes a single argument noun (a number, a cell, or a list).
:: ===========================================================================
import std
import ui
import gfx
core tool
  :: --- simple numeric commands -------------------------------------------
  square = fn [n] -> (mul n n)
  cube   = fn [n] -> (mul n (mul n n))
  double = fn [n] -> (add n n)

  :: nth Fibonacci number (0,1,1,2,3,5,…)
  fib = fn [n] ->
          loop with [a = 0, b = 1, i = n] :
            if (i == 0) then a else again(b, (add a b), (dec i))
          end

  :: factorial n!
  fact = fn [n] ->
           loop with [acc = 1, i = n] :
             if (i == 0) then acc else again((mul acc i), (dec i))
           end

  :: greatest common divisor of a cell [a b] (Euclid)
  gcd = fn [p] ->
          let a = (head p) in
          let b = (tail p) in
          loop with [x = a, y = b] :
            if (y == 0) then x else again(y, (mod x y))
          end

  :: 1 + 2 + … + n   (closed form, rides the std jets)
  sumto = fn [n] -> (div (mul n +(n)) 2)

  :: sum of a 0-terminated list
  sumlist = fn [xs] -> (foldl (fn [a b] -> (add a b)) 0 xs)

  :: --- list / sieve commands ---------------------------------------------
  :: is n prime?  (Loom loobean: 0 = yes, 1 = no)
  isprime = fn [n] ->
              if (lt n 2) then 1
              else loop with [d = 2] :
                     if (gt (mul d d) n) then 0          :: no divisor found ⇒ prime
                     else if ((mod n d) == 0) then 1     :: divisible ⇒ composite
                     else again(+(d))
                   end

  :: every prime ≤ n, as a list
  primes = fn [n] -> (filter (fn [x] -> (isprime x)) (range +(n)))

  :: count of primes ≤ n
  countprimes = fn [n] -> (len (primes n))

  :: Collatz stopping time of n
  collatz = fn [n] ->
              loop with [x = n, steps = 0] :
                if (x == 1) then steps
                else if ((mod x 2) == 0) then again((div x 2), +(steps))
                else again((add (mul 3 x) 1), +(steps))
              end

  :: --- a command that returns text (a cord) -----------------------------
  greet = fn [_] -> %orpheus

  :: --- a graphical front end, as data (open with `ui Tool.calc`) ---------
  :: A panel is built from ui.lat constructors; the GUI renders it as a live
  :: viewer whose buttons run the commands below with $n = the field's value.
  calc = fn [_] ->
    (panel %Calculator
      [ (row [ (label %n) [ (field %n %12) 0 ] ])
      [ (row [ (button %fib    [ %Tool.fib    [ %$n 0 ] ])
             [ (button %fact   [ %Tool.fact   [ %$n 0 ] ])
             [ (button %square [ %Tool.square [ %$n 0 ] ])
             [ (button %primes [ %Tool.primes [ %$n 0 ] ]) 0 ] ] ] ])
      [ (label %results-appear-in-the-Log)
      0 ] ] ])

  :: --- a drawing command: a parametric scene for the gfx renderer --------
  :: `gfx (rings 6)` in the System GUI embeds the SVG in the Log.
  rings = fn [n] ->
    loop with [i = 0, acc = 0] :
      if (gte i n) then (reverse acc)
      else again(+(i),
        [ (circle (add 60 (mul i 36)) 70 (add 16 (mul i 6)) (rgb (mul i 40) 80 (sub 200 (mul i 25)))) acc ])
    end
end
